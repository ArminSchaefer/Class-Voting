@article{Ferrera.2003,
 abstract = {The deepening of EUropean integration has weakened the traditional coercive monopoly of the state on actors and resources that are crucial for the stability of redistriubtive institutions. The article explores these issues adopting a 'state-building' perspective and drawing on Stein Rokkan's pioneering insights on boundary building and internal structuring. The first part of the article briefly presents the theoretical perspective. The second part sketches the development of national welfare instiutions up to the early 1970s, underlining the importance of bounding processes. The third part describes the challenges recently remerged to the social sovereignty of the nation-state largely linked to European integration. The final part offers some more speculative  remarks on the changing architecture of social pretection, with some hints at cross-national variation and possible developments at the European level.},
 author = {Ferrera, Maurizio},
 year = {2003},
 title = {European Integration and National Social Citizenship. Changing Boundaries, New Structuring},
 keywords = {Integration;social dimension;welfare state},
 pages = {611--652},
 volume = {36},
 number = {6},
 journal = {Comparative Political Studies}
}


