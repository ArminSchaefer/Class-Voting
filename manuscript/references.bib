@incollection{Wincott.2000,
 abstract = {Wincott argumentiert f{\"u}r einen dezidiert {\textquotedbl}politischen{\textquotedbl} Ansatz, der Restriktion f{\"u}r europ{\"a}ische Wohlfahrtsstaaten nicht auf abstrakte Kr{\"a}fte der Globalisierung abw{\"a}ltzt, sondern konkrete Entscheidung relevanter Akteure in Bezug auf die Gestaltung der EU einbezieht. Es gibt keinen unmittelbaren, direkten Zusammenhang zwischen Krise und folgender Handlung (im Sinne einer funktionalistischen Notwendigkeit), sondern es sind immer die Wahrnehmungen von Akteuren, ihre Strategien und m{\"o}gliche Gegentendenzen, die zu einem (kontingenten) Ergebnis f{\"u}rhen. Insofern k{\"o}nnen Entscheidungen in der Vergangenheit und resultierende Institutionen daraufhin {\"u}berpr{\"u}ft werden, wie sie den Entscheidungsspielraum heute verengen - sie treten dann jedoch als politische Entscheidungen ins Blickfeld und nicht als entpolitisierte, {\"o}knomisch notwendige Sachentscheidungen.},
