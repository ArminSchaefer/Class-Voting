@article{Hacker.2004,
 abstract = {Over the last decade, students of the welfare state have produced an impressive body of research on retrenchment, the dominant thrust of which is that remarkably few welfare states have experienced fundamental shifts. This article questions this now-conventional wisdom by reconsidering the post-1970s trajectory of the American welfare state, long considered the quinteessential case of social policy stability. I demonstrate that although most progreams have indeed resisted retrechment, U.S. social polciy has also offered increasingly incomplete risk protection in an era of dramtic social change. Althought some of this disjuncture is inadvertent - an unitended consequence of the very political stickiness that has stymied retrechment - I argue that hte decliing scope of risk protection also reflects deliberate and theoretically explicable strategies of reform adopted by welfare state opponents in the face of popular and change-reistant policies, a finding that has significant implications for the study of institutional chane more broadly.},
 author = {Hacker, Jacob S.},
 year = {2004},
 title = {Privatizing Risk without Privatizing the Welfare State: The Hidden Politics of Social Policy Retrenchment in the United States},
 keywords = {Esping-Andersen;Pierson;retrenchment;welfare state},
 pages = {243--260},
 volume = {98},
 number = {2},
 journal = {American Political Science Review},
 file = {Hacker 04:Attachments/Hacker 04.pdf:application/pdf}
}


