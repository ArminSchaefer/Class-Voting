@article{Peterson.1995,
 abstract = {Renewed interest in theorizing about the process of European integration is reflected in recent scholarship on the political evolution of the European Union (EU). Meanwhile, a rich an growing literature has emerged on EU policy-making in specific policy sectors. Yet the gap remains wide between theoretical models which seek to explain broad patterns of European integration and those which seek to explain the EU's policy-making process. This article conceptualizes 'policy networks' as a tool for analysing EU policy-making. Its central argument is that hte EU is a 'hothouse' for different types of policy networks, for two reasons. First, the EU lacks 'off-the-shelf' institutions which can facilitate informal bargaining betrween different typoes of actor. Secondly, decisions taken at the formulation stage have become important determinants of eventual EU policy outcomes in recent years. The policy networks model is placed within a broader theoretical framework for studying decision-making in the European Union at different levels of analysis.

Interessant an dem Aufsatz ist, dass Peterson vorschl{\"a}gt f{\"u}r verschiedene Bereiche (level of analysis) unterschiedliche Theorien anzuwenden. Das hei{\ss}t, die IGC und 'grand bargains' erfordern ein anderes theoretisches Werkzeug als die routinem{\"a}{\ss}ige Politik in Aussch{\"u}ssen oder auch auf Ministerebene. Allerdings m{\"u}sste dieser Ansatz noch klarer heraus gerabeitet werden, es bleibt bei Peterson ein erster konzeptioneller Ausblick.},
 author = {Peterson, John},
 year = {1995},
 title = {Decision-making in the European Union: towards a framework for analysis},
 keywords = {advocacy coalitions;epistemic communities;EU decision-making;Integrationstheorie;issue networks;level of analysis;policy networks},
 pages = {69--93},
 volume = {2},
 number = {1},
 journal = {Journal of European Public Policy}
}


@article{Peterson.1999,
 abstract = {This article assesses the evolution of the European Commission's role, power and effectiveness in the post-Delors era. It develops four main arguemtns. First, the performance of the Commission should be judged by its ability to futher the European Union's basic objectives, defend the 'Community interest', offer leadership, and operate efficiently. Second, the early Delros Commissions were far more an exception in their strength than is the Santer's in its weakness. Third, Santer promises to leave a legacy of a abetter managed Commission, but one that is also more fragmented and riven by sectoral and national rivalries. Fourth, theories of EU governance must be able to capture the 'actor-based' nature of EU policy-making, the lack of any dichotomy between the interests of 'national governments' and 'EU institutions', and the determinant effect of the political and economic environment in which the EU operates.},
 author = {Peterson, John},
 year = {1999},
 title = {The Santer era: the European Commission in normative, historical and theoretical perspective},
 keywords = {Delors;entrepreneurship;European Commission;Integration},
 pages = {46--65},
 volume = {6},
 number = {1},
 journal = {Journal of European Public Policy}
}


@article{Peterson.2001,
 abstract = {European Union (EU) studies have entered a highly contentious and, arguably, creative phase. A range of theoretical perspectives, seemingly quite highly differentiated from one another, now compete for influence and `space'. However, the questions remain: is EU studies developing theories which are truly competing theories? Or is it developing theories that do not compete so much as they aim to explain distinctly different pieces of the EU puzzle? This paper responds directly to these two questions, while reviewing recent literature on EU governance. It argues, first, that we lack theories of EU governance that are true rivals; and, second, that leading models explain different outcomes at different levels in a multi-level system of governance. The result is somewhat phoney debates between compatible theories masquerading as rivals, and between `comparative politics' and `international relations' approaches. Above all, perhaps, we find middle range theories posing as general or `meta-theories'. In the absence of a plausible general theory of EU governance, theorists must choose precisely which type of outcome they wish to explain.},
 author = {Peterson, John},
 year = {2001},
 title = {The choice for EU theorists: Establishing a common framework for analysis},
 keywords = {governance;Integration;Integrationstheorie;intergovernmentalism;Moravcsik},
 pages = {289--318},
 volume = {39},
 number = {3},
 journal = {European Journal of Political Research}
}


