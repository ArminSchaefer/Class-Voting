@incollection{Thelen.1992,
 abstract = {We begin with a brief discussion of the building blocks of this approach: how institutions are defined and how they figure into the analysis. Second, we sketch the characterstic features of historical institutionalism and the broader theoretical project tha animates institutional analyses. New institionalists draw inspiration and insights from older traditions in economic, political science, and sociology. Third, we turn to a discussion of the frontier issues in historical institutionalism. These frontiers are defined by the limits of the historical institutional literarture to date, that is, questions on which historical institutionalists have until now been relatively silent. We focus on two such areas: the question of institional dynamism and the interaction of institutional and ideational variables in policy formation and change.},
 author = {Thelen, Kathleen and Steinmo, Sven},
 title = {Historical Institutionalism in Comparative Politics},
 keywords = {historical institutionalism;ideas;institutional change;institutions;interests;rational choice},
 pages = {1--32},
