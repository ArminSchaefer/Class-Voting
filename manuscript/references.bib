@article{Massey.1990,
 abstract = {This article argues that racial segragation is crucial to explaining the emergence of the urban underclass during the 1970s. A storng interaction between rising rates of poverty and high level of residential segregation explains where, why, and in which groups the underclass arose. This argument is developed with simulations that replicate the economic conditions observed among blacks and whites in metropolitan areas during the 1970s but assume difference conditions of racial and class segregation. These data show how a simple increase in the rate of minoirty poverty leads to a dramatic rise in the concentration of poverty when it occurs whitin a racially segregated city. Increases in poverty concnetration are, in turn, associated with other changes in the socioeconomic character of neighborhoods, transforming them into physically deteriorated areas of high crime, poor schools, and excessive mortality where welfare -dependend, female-headed famililes are the norm. Thus, policies to solve the socioeconomic problems of minorites will fail unless they are accompanied by measures of overcoming the disadvantages caused by racial discrimination and prejudice in the housing market.},
 author = {Massey, Douglas S.},
 year = {1990},
 title = {American Apartheid: Segregation and the Making of the Underclass},
 pages = {329--357},
 volume = {96},
 number = {2},
 journal = {American Journal of Sociology}
}


