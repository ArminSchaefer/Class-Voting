@article{Obradovic.1995,
 abstract = {Setting out the legal framework for European collective bargaining, the Social Policy Agreementappended tot he Maastricht Treaty appears to introduce some corporatist chracteristics to the Union policy process. This article explores whether this legal framework really does represent a sufficient basis for introducing a new, corporatist policy formation mode at the European level. The main cluclusion isthat the existing infrastructure of organized management and labour at the Europpean level, as well as that of the European Union (EU) institutions concerned, does not provide the appropriate institutional set-up for corporsatist policy partnership formalized by the Maastricht Social Annex. Nevertheless, the Agreement is not withou utility. If its 'reflexive potential' (i.e. its capability to shape European collective bargaining by defining procedural norms and liiting or expanding the competences of the social partners) is taken into account, the Agreement can be regarded as a framework under whichthe lageal premises can be transformed into self-regulatory procedures for social policy in the Union.},
 author = {Obradovic, Daniela},
 year = {1995},
 title = {Prospects for corporatist decision-making in the European Union: the social policy agreement},
 keywords = {collective bargaining;corporatism;ETUC;Euro-corporatism;social dialogue;social protocol;UNICE},
