@article{Regent.2002,
 abstract = {Ganz guter {\"U}berblick {\"u}ber die Entwicklung der Besch{\"a}ftigungsstrategie seit Essen. In der Bewertung sehr optimistisch, soft regulation (Neovoluntarismus) wird als ad{\"a}quates policy-instrument angesehen. Bezieht sich stark auf offizielle Dokumente, ohne zu fragen, ob Absichtserkl{\"a}rungen wirklich umgesetzt werden.

The purpose of this article is to analyse this new tool of intervention and unscore its potential to offer a model of suprantional governance. The Open Method of Co-ordination is composed of different phases, each one deeply marked by a common feature: co-ordination. The very structure of OMC relies on the presents of a supranjational actor able to co-ordinate. But in order to grasp its importance, one cannot consider OMC only from the Lisbon Summit. To have a fully-fledged comprehension of this new regulatory tool, it is necessary to look at the whole development of the European Employment Strategy. it is in the field of employment that this method finds its premises and was first developed. With this background, it is possible to see from where the different components of OMC come, and also to give a clearer picture of the fundamentals of this new form of governance.},
 author = {R{\'e}gent, Sabrina},
 year = {2002},
 title = {The Open Method of Co-ordination: A supranational form of governance?},
 keywords = {EES;Essen Follow-up;Lisbon strategy;Luxembourg Process;omc;peer review;soft law},
