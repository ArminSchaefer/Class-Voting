@article{Majone.2001,
 abstract = {The central thesis of this paper is that in order to understand fully the governance structure of the EC/EU it is necessary to go beyond agency theory. Although the key problems of agency theory - hidden action and hidden information - are present in any relation based on specialization and division of labour, they are not central to the study of fiduciary relations. Such relations have been largely neglected by students of European integration, in spite of their importance  whenever open-ended tasks are assigned to individuals of institutions enjoying a considerable degree of discretion. The change of focus from the relatively simple relations investigated by current prin-cipal-agent theory to situations where contractual incompleteness and open-ended commitments are of paramount importance suggests a new research programme having as its main themes the proper scope of the fiduciary principle in EU govern-ance, and the efficiency of various kinds of fiduciary duties in disciplining the discre-tion of all the actors of European integration.},
 author = {Majone, Giandomenico},
 year = {2001},
 title = {Two Logics of Delegation. Agency and Fiduciary Relations in EU Governance},
