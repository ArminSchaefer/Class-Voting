@article{Enderlein.2006,
 abstract = {This article suggests an explanation for seemingly diverse patterns of change in domestic economic institutions following the establishement of EMU. It argues that EMU participants redesigned ill-fitting domestic fiscal and wge-setting institutions in order to counter the anticipated destailizing effects of the 'one size fits all' monetary policy of the ECB. After outlining the argument, the article identifie general economic and instutional conditions that are required for the use of fiscal and wage-setting institujtions as effecive stabilizers in a monetary union. It then undertakes a comparative assessment to detect country-specific mismatches between anticiapted needs and the available domestic economic instituitons. Finally, the article surveys institutional changes in ten member states between the mid 1990s and 2002 and shows that hte observed institutional adjustments largely corresond to the expected correction of initial mismatches.},
 author = {Enderlein, Henrik},
 year = {2006},
 title = {Adjusting to EMU. The Impact of Supranational Monetary Policy on Domestic Fiscal and Wage-Setting institutions},
 keywords = {EMU;social pacts},
 pages = {113--140},
 volume = {7},
 number = {1},
 journal = {European Union Politics}
}


@article{Engelen.2007,
 abstract = {Even though more than half of all citizens in the world are currently able to exercise the right to elect their leaders, many of them choose not to vote. This article considers the role of compulsory voting in order to enhance the democratic values of political participation and equality. Raising turnout considerably, it is an effective instrument to motivate citizens to express their voice in public life, thereby  ensuring that their concerns will be heeded. Opponents of compulsory voting, however, argue that it is undesirable because it violates the value of personal liberty and drags uninterested citizens to the polls. This article tries to rebut these arguments and challenge their underlying concept of democracy. As compulsory voting sends the message that every vote matters, it is able to restore rather than harm democracy and its values.},
 author = {Engelen, Bart},
 year = {2007},
 title = {Why Compulsory Voting Can Enhance Democracy},
 keywords = {democracy;participation;turnout},
 pages = {23--39},
 volume = {42},
 journal = {Acta Politica},
