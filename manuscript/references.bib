@misc{Tidow.1998,
 abstract = {Tidow argumentiert, das v.a. die doppelte Post-Maastricht-Krise dazu gef{\"u}hrt, Besch{\"a}ftigungspolitik auf der europ{\"a}ischen Ebene zu verankern. Seit 1993 hat die Kommission dazu Vorschl{\"a}ge entwickelt, die ihren Niederschlag im Wei{\ss}buch {\textquotedbl}Wachstum, Wettbewerbsf{\"a}higkeit und Besch{\"a}ftigung{\textquotedbl} fand. F{\"u}r den von ihr vorgeschlagenen Policy-Mix fand sich jedoch keine Mehrheit.  Im Folgenden wird die Entwicklung bis zum Amsterdamer Gipfel nachgezeichnet, indem die Positionen der entscheidenden Akteure aufgezeigt werden. Es wird deutlich, dass der Spielraum f{\"u}r eine Europ{\"a}ische Besch{\"a}ftigungspolitik von Anfang an begrenzt war, sodass es f{\"u}r die Bef{\"u}rter schon ein Erfolg war, dass der Amsterdamer Vertrag {\"u}berhaupt ein Besch{\"a}ftigungstitel enth{\"a}lt. Deutlich wird zudem, die entscheidende Bedeutung, die einer Strukturierung der Debatte zukommt.},
