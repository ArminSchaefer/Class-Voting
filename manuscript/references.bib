@article{Johansson.1999,
 abstract = {This article traces the employment title in the Amsterdam treaty, with the aim of uncovering the role of transational coalitions. The perspectives of transational coalition-building  and policy-amking, in the European Union, are combined to shed light on transnational strategies of influence. Such strategies were employed by politcal parties and trade unions. They are treated as linkage actors in a transmission system, or belt, linking the domestic and supranational levels to one another. Institutions in the European Union are conceived of as both carriers of their own strategies and access points. By identifying support and initiatives on the part of governments, an attempt is also made to assess the realtive importance of intergovernmental and transnational channels. A termporal dimension is thus injected. In conclusion, it can be shown that the employment title was to a large extent a result of a transnational policy contribution.

- es wird beschrieben, wie sich eine Koalition f{\"u}r eine Europ{\"a}ische Besch{\"a}ftigungspolitik heraus-bildete. Daran waren ma{\ss}geblich skandinavische Sozialdemokraten, die Europ{\"a}ischen Sozialde-mokraten, ETUC und Vertreter der DG V beteiligt;

- entgegen anderer Texte wird argumentiert, dass sich die Bundesregierung nicht einem Besch{\"a}fti-gungskapitel entgegen gestellt h{\"a}tte [allerdings ist eine solche Aussage problematisch, weil die deutsche Strategie darauf hinauslief, den Inhalt zu verw{\"a}ssern. In diesem Aufsatz wird aber fast ausschlie{\ss}lich {\"u}ber die Frage wie {\"u}berhaupt ein Besch{\"a}ftigungstitel in den Vertragstext kam, ge-sprochen];

- Seite 96 gibt einen {\"U}berblick {\"u}ber die Positionen der einzelnen Regierungen {\`a} Vergleich mit Ti-dow;

- Methode ist fragw{\"u}rdig: die Konzentration darauf, dass es fr{\"u}h eine transnationale Koalition gab, die f{\"u}r ein Besch{\"a}ftigungskapitel war, ist nur bedingt aussagekr{\"a}ftig. Es m{\"u}sste {\"u}berpr{\"u}ft werden, welche inhaltlichen Vorstellungen sie hatten und inwiefern diese durchgesetzt werden konnten. Ansonsten wird die leere {\textquotedbl}H{\"u}lse{\textquotedbl} Besch{\"a}ftigungstitel zu einem Erfolg stilisiert.},
 author = {Johansson, Karl Magnus},
 year = {1999},
 title = {Tracing the Employment Title in the Amsterdam Treaty: Uncovering Transnational Coalitions},
 keywords = {advocacy coalitions;employment title;linkage actors;transnational coalitions},
 pages = {85--101},
 volume = {6},
 journal = {Journal of European Public Policy}
}


