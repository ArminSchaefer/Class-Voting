 year = {1996},
 address = {Opladen}
}


@article{Bieling.2001,
 abstract = {This article looks at the meaning of European integration along neo-liberal lines for trade union involvment. With a shift in power towards capital, trade union involvement has not ceased but taken on another form: this is exemplified by the shift from demand-side to supply-side or competitive corporatism. Trade unions have got a role to play in the new European economy at the company level, the national level, and, largely symbolically, at the European level. They are thus part of an economic restructuring through various {\textquotedbl}social pacts{\textquotedbl}. The authors remains skeptical whether this turn out to be a viable strategy in the long run.},
 author = {Bieling, Hans-J{\"u}rgen and Schulten, Thorsten},
