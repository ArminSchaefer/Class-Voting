@article{Zurn.1996,
 abstract = {Dieser Artikel unternimmt es, die Europ{\"a}ische Integration in den allg. Kontext der ungleichzeitigen Denationalisierung zu stellen, und konstatiert dabei sowohl eine abnehmende politische Steuerungsf{\"a}higkeit des Nationalstaates als auch eine reduzierte gesellschaftliche Kontrolle der Entscheidungstr{\"a}ger. Vor diesem Hintergrund greift der Beitrag in die gegenw{\"a}rtige Diskussion {\"u}ber as Demokratiedefizit der EU ein. Gemessen an vier Voraussetzungen und Merkmalen eines demokratischen Gemeinwesens, die besonders von den analysierten Ver{\"a}nderungen betroffen sind (Kongruenz-, Identit{\"a}ts-, Reversibilit{\"a}ts-, und Zuordnungsbedingung) weisen die beiden in der Lit. am h{\"a}ufigsten gemachten Vorschl{\"a}ge zur Behebung des Demokratiedefizits (St{\"a}rkung des EP und autonomieschonende Koordination) Schw{\"a}chen auf. Als Alternative wird daher die Demokratisierung der territorialen Vertretung und die Einf{\"u}hrung direkt-demokratischer Elemente zur Diskussion gestellt.},
 author = {Z{\"u}rn, Michael},
