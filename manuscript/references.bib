@incollection{Moravcsik.1991,
 abstract = {Der Aufsatz zeichnet die Entwicklung, die zur Einheitlichen Europ{\"a}ischen Akte f{\"u}hrt nach, und zeigt dabei, dass die Vertragsreform im Wesentlichen aus der Kompromissbildung der drei wichtigsten MS, Deutschland, Frankreich und GB, erkl{\"a}rt werden kann. Der Kompromiss stellt jedoch einen Minimalkonsens dar, den interstate bargaining erwarten l{\"a}sst. Erm{\"o}glicht wurde er durch eine Konvergenz in der wirtschaftspolitischen Ausrichtung der drei Staaten. Moravscik geht es explizit darum, neofunktionalistischen Ans{\"a}tzen zu widersprechen, die supranationale Akteure als entscheidende Faktoren ansehen (z.B. Sandholtz und Zysman).

Eine entscheidende Rolle in der Erkl{\"a}rung spielt die wirtschaftspolitische Konvergenz zwischen Deutschland, GB und Frankreich, wobei FR erst nach dem Scheitern des {\textquotedbl}franz{\"o}sischen Experiments{\textquotedbl} auf die Marktintegration setzte. Frankreich wird in der Folge, so Moravscik, zum Motor der Integration indem es Zugest{\"a}ndnisse macht. Wie l{\"a}sst sich jedoch diese politische Kehrtwende zu neoliberalen Konzepten erkl{\"a}ren? Spielt nach dem Scheitern keynesianischer Politik nicht der Druck von IGC, Kommission und anderen supranationalen Akteuren eine Rolle, um zu erkl{\"a}ren, dass Marktintegration und neoliberale Konzepte als einzig verbleibende Alternative erschienen. Diese Perspektive r{\"u}ckt preference formation in den Blickpunkt, die nicht predeterminiert ist und Raum f{\"u}r andere Akteure l{\"a}sst --{\textgreater} vgl. March und Olsen.},
 author = {Moravcsik, Andrew},
 title = {Negotiating the Single European Act},
 keywords = {European integration;intergovernmental institutionalism;liberal intergovernmentalism;neofunctionalism;Sandholtz;SEA;Zysman},
 pages = {41--84},
 publisher = {{Westview Press}},
 editor = {Keohane, Robert O. and Hoffmann, Stanley},
 booktitle = {The New European Community. Decisionmaking and Institutional Change},
 year = {1991},
 address = {Boulder}
