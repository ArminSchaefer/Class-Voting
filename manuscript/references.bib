@article{Goesling.2001,
 abstract = {Fresh data sources on cross-national income are examined to document recent changes in the composition of world income inequality within and between nations. New evidence shows that during the 1980s and 1990s the composition of world income inequality experienced a fundamental change, characterized by the diminish- ing significance of between-nation income differences and the growing prominence of within-nation inequalities. Two competing trends account for this change: (1) steady growth in the average level of income inequality within nations, and (2) a decline in income inequality between nations. These recent trends signify a reversal in one of the major legacies of the Industrial Revolution-the internationalization of world income inequality across national borders. The findings raise important ques- tions for future studies of cross-national inequality and development.},
 author = {Goesling, Brian},
 year = {2001},
 title = {Changing Income Inequality Within and Between Nations: New Evidence},
 keywords = {inequality},
 pages = {745--761},
 volume = {66},
 issn = {00031224},
 journal = {American Sociological Review}
}


@article{Goetschy.1999,
 abstract = {The conclusions of the European summits since 1992 and the content of the Amsterdam Treaty seem to imply that the employemtn issue has finally reached the Community agenda. How far does the new approach differ from previous policy? How were the changes of the 1990s achieved? This article reviews previous EU social policy as regards employment issues, then analyses the different elements of the European employment strategy (EES) and offers a preliminary assessment. A major question addressed is how, compared to previous regulation methods, this new process i likely to affect the legitimacy and efficiency of 'Social Europe'.},
 author = {Goetschy, Janine},
 year = {1999},
 title = {The European Employment Strategy: Genesis and Development},
 keywords = {Amsterdam Treaty;EES;employment title;Essen Follow-up;historical development;NAP;social policy},
 pages = {117--137},
