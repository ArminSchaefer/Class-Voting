@incollection{Streeck.2005,
 abstract = {This paper explores to what extent Peter Katzenstein's seminal study of the 'semi-sovereign' German state in the 1980s is still valid. The paper looks at one of the showpieces of Katzenstein's theory of benficial semi-sovereignty, German industrial relations, and follows their development from the Modell Deutschland of the 1976 election campaign to Schr{\"o}der's B{\"u}ndnis f{\"u}r Arbeit. It come to the conclusion that as far as Germany is concerned, the days are gone when it was an advantage for the governance of industrial relations to have a weak state.},
 author = {Streeck, Wolfgang},
 title = {Industrial Relations: From State Weakness as Strength to State Weakness as Weakness. Welfare Corporatism and the Private Use of the Public Interest},
 pages = {138--164},
 publisher = {{Cambride University Press}},
 editor = {Green, Simon and Paterson, William E.},
