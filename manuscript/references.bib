@article{Cox.1998b,
 abstract = {In recent years Denmark and the Netherlands have made dramatic shifts from passive to active labor market policies. Though often portrayed as a necessary response to high levels of structural unemployment, such changes are more than a mere technical  adjustment of welfare programs to a changing economic climate. They reprresent new ideas about the goals of public policy and the social rights of citizenship. This article surveys the politics of labor market policies in the two countries to demonstrate that the recent activation programs reflect a departure from the ideas and goals of the post-war welfare state.

Cox geht davon aus, dass third order change auch angemessener ist, d.h. er repr{\"a}sentiert eine Anpassung an gegebene Probleme. Das bedeutet, der Druck der Arbeitslosigkeit erm{\"o}glicht es nicht mehr, die {\textquotedbl}alte{\textquotedbl}, passive Strategie weiter zu verfolgen. Aber ist deshalb notwendigerweise ein Wechsel zur aktiven Arbeitsmarktpolitik geboten? H{\"a}tte es keine Alternativen gegeben? Ideen haben hierbei keine Existenz unabh{\"a}ngig von den realen Problemen. Ist es nicht realistischer anzunehmen, dass policy-maker auf der Suche nach M{\"o}glichkeiten mit Problemen fertig zu werden, auf solche zur{\"u}ckgreifen, die en vogue sind oder m.a.W., die den g{\"a}ngigen Diskurs bestimmen?},
 author = {Cox, Robert Henry},
 year = {1998},
 title = {From Safety Net To Trampoline: Labor Market Activation in the Netherlands and Denmark},
 keywords = {activation;Denmark;Hall;ideas;liberal welfare state;Niederlande;policy paradigms;Skandinavian welfare state;social rights;workfare},
 pages = {397--414},
 volume = {11},
 number = {4},
 journal = {Governance}
}


@article{Cox.2001,
 abstract = {This article discusses the origins, the alleged decline, and the resurrection of US hegemony and its respective academic discussions. Rather than seeing the US on the decline (as has been discussed repeatedly since the 70s) the author assesses that America still is the hegemonic leader and probably will remains so for quite some time - there are no real rivals in sight and the changes so far do not put into question the structural power of the US.},
 author = {Cox, Michael},
 year = {2001},
 title = {Whatever Happened to American Decline? International Relations and the New United States Hegemony},
 keywords = {hegemonic leadership;IR;political economy},
 pages = {311--340},
 volume = {6},
 number = {3},
 journal = {New Political Economy}
}


@article{Cox.2001b,
 abstract = {Cox argues that much of the difference between DK, NL, and D can be explained by a factor that often gets overlooked, namely, the social construction of the need to reform. By this he means that reform was made possible in DK and NL by political leaders who mobilized public debate by a process called 'path shaping' - framing issues in ways that generated widespread support for reform initiatives. In Germany the debate remained polarized, with many important political actors rejecting the suggestion that reform was either necessary or desirable. The roform process was by no means easy in Denmark and the Netherlands, but after the path was shaped, controversy centered on the character and timing of reform. In Germany, however, the failure to shape a new path for reform resulted in a path-dependent stalemate.},
 author = {Cox, Robert Henry},
 year = {2001},
 title = {The social construction of an imperative. Why welfare reform happened in Denmark and the Netherlands but not in Germany},
 keywords = {activation;retrenchment;welfare state;workfare},
 pages = {463--498},
 volume = {53},
 number = {3},
 issn = {1086-3338},
 journal = {World Politics}
}


@article{Cram.1993,
 abstract = {Regulatory policy is presently the principal form of European Community (EC) social policy legislation affecting European citizens. One possible explantion of this trend is that hte Commission, far from being a neutral bureaucracy, has been an active force in pushing outward the frontiers of Community social policy. Expanding its skills, and learning from past experience, the commission makes maximum use of its limited powers in the social sphere. One important aspect of the Commission's opportunistic role may be its ability to prepare the ground for future regulatory action. The relatively costless nature of regulatory policy-making, from the point of view of the Commission's budget, increasingly allows the commission to call the proverbial tune without incurring the costs of paying the piper.},
