@article{Kaiser.2002,
 abstract = {Current endeavours to employ the concept of cosociational democracy in EU research are misleading. This critque starts from a minimalist concept of democracy with alternation and inclusion of preferences in government formation as a parsimonious way to maesure the extent to which political systems are majoritarian, consensual or even cosociational in character. It then presents empirical results for the current EU member states and examines whether the EU can be analsed in a similar way by using equaivalent indicators. Despite a superficial resemblance to consociational systems, a crucial variable is missing in the EU: the formation of a stable grand coalition enclusing all institutions involved in decision-making. What has been wrongly termed consociationalism at the European level is best regarded as intergovernmentalism.},
