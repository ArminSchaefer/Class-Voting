@article{Kenner.1999,
 abstract = {This article examines one of the novel aspects of the Amsterdam Treaty - the provision on Employment in the light of the {\textquotedbl}Third Way{\textquotedbl} agenda of the Blair government. After a brief explanation of what the Third Way is, the Author deals with the question of the new Community approaches to employment matters representing a step forward toward the implementation of soft law. The Author's opinion in that the Amsterdam Employment Title, and soft law instruments issued to make its provisions effective over the past two years, represent, as a collective body of Community rules, a positive affirmation of a policy approach that has become associated with the Third Way agenda. Nevertheless, in the case of the Community's employment policy this may require a strengthening of the legal framework, converting soft law into binding rules, as the most effective means to turn guidelines into solid achievements.},
 author = {Kenner, Jeff},
 year = {1999},
 title = {The EC Employment Title and the 'Third Way': Making Soft Law Work?},
 keywords = {Amsterdam Treaty;Besch{\"a}ftigungspolitik;coordination;employment title;soft law;Third Way},
