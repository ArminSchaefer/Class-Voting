@book{McNamara.1999,
 abstract = {Das Buch erkl{\"a}rt den Weg europ{\"a}ischer Staaten zur W{\"a}hrungsunion. Ein durchgehendes Interesse dieser Staaten bestand in stabilen Wechselkursen, weil ihre Volkswirtschaften im internationalen Vergleich sehr {\textquotedbl}offen{\textquotedbl} sind. Wechselkursschwankungen behindern aber die Rationalit{\"a}t des Handels. In den Nachkriegsjahrzehnten gew{\"a}hrleitete das Bretton Woods System, mit den USA als Hegemonialmacht, die Funktion des internationalen Wirtschaftssystems. Dies war die Situation des {\textquotedbl}embedded liberalism{\textquotedbl}. Nach dessen Zusammenbruch in Folge der {\"O}lkrisen, versuchten die Europ{\"a}er mit der W{\"a}hrungsschlange und dem EMS ein in der Wirkung {\"a}hnliches System aufzubauen. Mit steigender Kapitalmobilit{\"a}t geraten Wechselkursstabilit{\"a}t und eine autonome Geldpolitik (zur Nachfragesteuerung) zunehmend in Konflikt. Solang es ganz unterschiedliche Reaktionen innerhalb Europas auf die Krisen der 1970er gab - vor allem das unterschiedliche Ausma{\ss} des Keynesianismus - konnte ein stabiles Wechselkursregime nicht etabliert werden. Erst nachdem sich ein neoliberaler Konsens herausbildete - aufgrund der Faktoren: 1) policy failure, 2) alternative paradigm (monetarism) und 3) succesful example (Germany) - konnte dieses Ziel im EMS erreicht werden. Die EWWU schreibt diesen Konsens fort und bedeutet eine Institutionalisierung des deutschen Modells auf europ{\"a}ischer Ebene.},
 author = {McNamara, Kathleen R.},
 year = {1999},
 title = {The Currency of Ideas: Monetary Politics in the European Union},
 keywords = {Bretton Woods;capital mobility;competitive liberalism;embedded liberalism;EMS;exchange rates;hegemonic leadership;IMF;Snake;unholy trinity},
 address = {Ithaca/London},
 publisher = {{Cornell University Press}}
}


@article{McNamara.2002,
 abstract = {The conventional wisdom in support of central bank independence rests on a series of contestable arguments about the relationship between democracy, policy making, and economic outcomes. Empirical work casts doubt on the severity of the inflationary problems purportedly solved by delegation to independent central banks, as well as raising questions about the linkages between delegation and superior economic outcomes. So why delegate? Theories of institutional isomorphism, or the copying of organisational models, provide an alternative sociological explanation of the diffusion of central bank independence. Drawing on this approach, it is argued that governments choose central bank independence because delegation has important legitimising and symbolic properties that are attractive to political leaders in times of economic uncertainty. Delegation to independent central banks is rational, efficient, and acceptable in a democratic society because of the cultural processes which define it as such, not because of the functional requirements of economic management.},
 author = {McNamara, Kathleen},
 year = {2002},
 title = {Rational Fictions: Central Bank Independence and the Social Logic of Delegation},
 keywords = {central bank independence;commitment;credibility;delegation;isomorphism;principal-agent},
 pages = {47--76},
 volume = {25},
 number = {1},
 journal = {West European Politics}
}


