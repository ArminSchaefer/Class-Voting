@article{Brady.2023,
 abstract = {This review explains how and why the United States has systemically high poverty. Descriptive evidence shows that U.S. poverty is (i) a huge share of the population, (ii) a perennial outlier among rich democracies, (iii) staggeringly high for certain groups, (iv) unexpectedly high for those who {\textquotedbl}play by the rules,{\textquotedbl} and (v) pervasive across various groups and places. This review then discusses and critiques three prevailing approaches focused on the individual poor rather than the systemically high poverty: (i) behavioral explanations {\textquotedbl}fixing the poor,{\textquotedbl} (ii) emotive compassion {\textquotedbl}dramatizing the poor,{\textquotedbl} and (iii) cultural explanations both dramatizing and fixing the poor. The essay then reviews political explanations that emphasize the essential role of social policy generosity, political choices to penalize risks, power resources of collective political actors, and institutions. This review demonstrates a long emerging but ascending and warranted shift away from individualistic explanations of the poor toward political explanations of poverty.},
 author = {Brady, David},
 year = {2023},
 title = {Poverty, not the poor},
 pages = {eadg1469},
 volume = {9},
 number = {34},
 journal = {Science advances},
 file = {Brady 23:Attachments/Brady 23.pdf:application/pdf}
}


