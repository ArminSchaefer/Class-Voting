@article{Mayer.1992,
 abstract = {The present article seeks to extend our understanding of the relationship between domestic politics and international negotiation in two important ways. First, it provides a framework for thinking more systematically about the effects of domestic division on interntaional negotiation. In particular, this framework helps to clarify the conditions under which internal division can be an asset in internatonal negotiations and those in which it is likely to be a liability. Second, it focuses on an important characteristic of internal process - the capacity of domestic factions to make side-payments to one another in the currency of issues likned to the bargain in question - and demostrates that there is a strategic dimension to the use of such linkages. Third, the article discusses some of the policy implications of the analysis, with particular attention to the implications for the design of policymaking processes. (795)},
 author = {Mayer, Frederick W.},
 year = {1992},
 title = {Managing domestic differences in international negotiations: the strategic use of internal side-payments},
 keywords = {bargaining;two-level games},
 pages = {793--818},
