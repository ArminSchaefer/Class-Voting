@article{Hosli.2000,
 abstract = {The European economic and monetary union (EMU) is widely viewed as one of the most important developments in recent European integration. But it is less clear why EMU was started at all, and, more specifically, what the role of individual European Community (EC) embmer states has been in this process. Most importantly, some puzzling questions areise when trying to establish why Germany favored EMU, and as to its relative imporatnce in the intergovernmental negotiations. This article focuses o the negotations that led tothe establishment of the EMU. It first descirbes the environment in which the decision was made to move from the existing European monetary system (EMS) to EMU. It then seeks to explain how agreement was reached on EMU on on its institutional provisions and timing as foreseen in the Treaty on European Union (TEU) and its information on the preferences that EC governments held with respect to different aspects of EMU. In addition, it employs simple negotation models to explore these issues and looks into possible two-level game dynamics that may have influenced the intergovernmental bargaining process.},
 author = {Hosli, Madeleine O.},
 year = {2000},
 title = {The Creation of the European Economic and Monetary Union (EMU): Intergovernmental Negotiations and Two-Level Games},
