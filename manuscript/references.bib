@article{Tsebelis.2000,
 abstract = {The veto players theory can be used to analyze all political systems regardless of regime (presidential or parliamentary), party system (one-, two-, or multiparty), and type of parliament (unicameral or multicameral). This paper develops theveto players theory to account for a series of important political phenomena: the importance of agenda control and referendums; the reaons for government stability (parliamentary systems) and regime stability (presidential systems); the reasons for independence of bureaucracies, and judicial independence. All these phenomena are analyzed in a coherent way, on the basis of the same framework. Empirical evidence from existing literature corroborating the theory is provided.},
