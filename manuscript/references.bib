@incollection{Merkel.2012,
 abstract = {Auf die Frage, wie sich Demokratie eigentlich begreifen lasse, lieferte Robert Dahl, der bedeutendste Demokratietheoretiker der zweiten H{\"a}lfte des 20. Jahrhunderts, eine schlanke Antwort: {\glqq} public contestation and the right to participate {\grqq}. Die Polyarchie, wie Dahl real existierende Demokratien nennt, besitzt seines Erachtens zwei konstituierende Dimensionen. Es muss ein offener Wettbewerb um politische {\"A}mter und Macht garantiert sein und gleichzeitig ein ausreichender Raum f{\"u}r die politische Partizipation ge{\"o}ffnet werden. Wir wollen hier nicht diskutieren, ob damit die Demokratie hinreichend zu konzeptualisieren ist. Aus der Tradition von John Locke und Montesquieu heraus oder gem{\"a}{\ss} den rechtsstaatlichen Erw{\"a}gungen von den Federalists bis zu J{\"u}rgen Habermas kann die Leerstelle der rechtsstaatlich gesicherten Herrschaftskontrolle kritisiert werden.},
