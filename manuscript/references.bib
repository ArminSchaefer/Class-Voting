@article{Woods.1995,
 abstract = {This article makes the case for investigating much more closely the substance of economic ideas in international relations. Recent attention to ideas in international relations assesses the impact of ideas on policy making but tells us very little about what types of economic ideas are most likely to be influenctial. Rather, the attention in 'rationalist' approaches to international political economy is on political processes, given a set of actors' preferences or preceptions of interests. Ignored are the reasons particular sets of economic ideas are invoked to define these preferences and interests. This article offers a critque of eixting rationalist approaches to economic ideas and international relations and sets out a preliminary new reserach agenda. The new agenda draws on insights from psychological and social theory so as to explicitly to address what typoes of economic ideas are most likely to influence foreign economic policy making.},
 author = {Woods, Ngaire},
 year = {1995},
 title = {Economic Ideas and International Relations: Beyond Rational Neglect},
 keywords = {economic ideas;ideas;ideologies;international relations;Neoliberalism},
 pages = {161--180},
 volume = {39},
 issn = {1468-2478},
 journal = {International Studies Quarterly}
}


@incollection{Woolley.1994,
 abstract = {An important and fateful decision early in the Maastricht process was to conduct two prallel intergovernmental conferences: one on economic and monetary unification, the other on polical unification. This linkage was effected primarily because Germany insisted on it, with Helmut Kohl playing a key role in formulating and negotiating from the German position. The German strategy of linking monetary and political union is analyzed in terms of the 'two-level game' metaphor developed especially by Putnam. The strategy cannot be understood without taking account of both levels of the game: the dramatic changes in the international environment (especially the collapse of the East German regime) and the constraints imposed by German domestic politics. German domestic political commitments and instituions deserve special emphasis.},
 author = {Woolley, John T.},
 title = {Linking Political and Monetary Union: the Maastricht Agenda and German Domestic Politics},
 keywords = {domestic politics;EMU;German unification;Germany;issue linkages;Maastricht Treaty;political union;two-level games},
