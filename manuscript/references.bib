@article{Jessop.1993,
 abstract = {Drawing on the regulation approach {\&} Marxist state theory, preliminary remarks are presented on two major changes occurring in the form {\&} functions of the capitalist state in Europe {\&} North America: (1) a tendential transition from the Keynesian welfare state associated with Atlantic Fordism to a Schumpeterian workfare state more suited to the regulation of a post-Fordist economic order; {\&} (2) the {\textquotedbl}hollowing out{\textquotedbl} of the nation-state through the transfer of powers upward {\&} downward, as well as through the development of transborder links between local authorities. These changes derive in part from four sets of changes in the capitalist economy: the rise of new core technologies, increasing internationalization, the paradigm shift from Fordism to post-Fordism, {\&} a politically {\&} economically motivated trend toward regionalization. Different trajectories {\&} strategies en route to a hollowed out Schumpeterian workfare state are discussed: neoliberal, neocorporatist, {\&} neostatist. Reflections on the tendential character of these changes are offered.},
 author = {Jessop, Bob},
 year = {1993},
 title = {Towards a Schumpeterian Workfare State? Preliminary Remarks on Post-Fordist Political Economy},
 keywords = {Fordism;keynesian welfare state;Post-Fordism;restructuring of the state;Schumpeterian Postnational Workfare Regime},
 pages = {7--39},
 volume = {40},
 number = {1},
 journal = {Studies in Political Economy}
}


@article{Jessop.1995,
 abstract = {This paper critically compares and evaluates regulationist and governance approaches tothe transformation of the local state. It is prompted by the close connection often made between the transition from Fordism to post-Fordism and new forms of economic and political governance. It then considers the basic (meta-)theoretical assumptions and core concepts of the two paradigms and identifies parallels and convergences as well as some important differences in theoretical or substantive focus. Attention then shifts to possible conflicts or tensions between regulation and governacne as axes of crisis-managment and crisis-resultion in local economies and states. The paper notes some problems in attempts to combine concepts and arguments relating to governance and regulation and highlights the importance of the organization of inter-organizational relations in resolving regulation and governance problems. It concludes with suggestions for subsequent research on these issues.},
 author = {Jessop, Bob},
 year = {1995},
 title = {The regulation approach, governance and post-Fordism: alternative perspectives on economic and political change?},
 keywords = {governance;Post-Fordism;regulation theory;state theory},
 pages = {307--333},
 volume = {24},
 number = {3},
 journal = {Economy and Society}
}


@article{Jessop.1999,
