@article{Genschel.2004,
 abstract = {There are basically three stories about the globalisation-welfare state nexus. The first story argues that globalisation is the cause of chronic crisis of the welfare state. As national economies open to the international market, governments are forced to adapt to the imperatives of global competition, and this means cutting cost-intesive welfare programs (globalisation theory). The second story argues that whatever the cuase of the welfare state crisis, globalisation is not part of it. There is netiher theoretical reason nor empirical evidence to believe that  national policy autonomy has decreased due to increasing economic interdependencies (globalisation seceptics). The third story holds that globlisation, far from causing the welfare state's troubles, is a condequence of these troubles, and part of their solution (revisionism). The paper reviews each of these stories, and counterposes them to simple desciptive statistics on OECD countries.},
 author = {Genschel, Philipp},
 year = {2004},
 title = {Globalisation and the Welfare State: A Retrospective},
 keywords = {globalization;regional specialization;small states;social policy;welfare capitalism},
 pages = {613--636},
