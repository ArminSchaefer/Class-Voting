@article{Ardy.2001,
 abstract = {Since the signing of the Maastricht Treaty, the EU has paid increasing attention to employment creation, yet has few formal powers in this area. A series of agreements, known as 'processes' and named after the city where they were agreed, has been made to co-ordinate employment policy. This paper will explain how the 'Luxembourg process', under which member states structure their employment policies, works and will offer a critique of the 'open co-ordination' approach to employment policy. The focus will then shift to the extent to which the OMC represents simply a first stage in the eventual communiterisation of policy or new method in its own right. It will also confront the question of whether this form of policy can be expected to go far enough to constitute a sufficienty robust 'real' economy counterpart to monetary union.},
 author = {Ardy, Brian and Begg, Iain},
 year = {2001},
 title = {The European Employment Strategy: Policy Integration by the Back Door?},
 keywords = {benchmarking;Employment strategy;guidelines;Luxembourg Process;NAP;omc},
