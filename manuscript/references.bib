@article{Streit.1995,
 abstract = {The present paper analyses, from an economic point of view, the changes in the economic constitution of the European Community since its foundation in 1958. In order to identify various changes, we start by developing an economic frame of reference. Our proposition is that hte constitution of the European Community (1958) came closest to this frame of reference: an economic constitution for a market system. In the subsequent parts, we try to show that the process of European integration war largely based on the introduction of non-market elements. Our final arguement will be that as afar as the economic constitution is concerned, the Treaty on European Union is dominated by trains which are characteristic of modern welfare states.},
