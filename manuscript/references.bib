@article{Visser.2000,
 abstract = {This article attempts to highlight the interaction of developments in European social and employment policy-making with the changing conditions and patterns in national political economies, labour markets and labour relations. It argues that a shift is taking place from traditional social policy, aiming at equality of outcomes, to an activating employment policy, directed towards achieving equality of opportunity. This shift is analysed against the background of the demise of the Fordist model, the Keynesian compromise of the mixed economy, the increase in product market competition and internationalization of the European economy, the externalization of social policy from large firms, the rise in unemployment, Europe's continued high-cost welfare states and the decline of organized labour.},
 author = {Visser, Jelle},
 year = {2000},
 title = {From Keynesianism to the Third Way: Labour Relations and Social Policy in Postwar Western Europe},
 keywords = {Employment strategy;golden age;keynesian compromise;social policy;supply-side equalitarianism;Third Way},
 pages = {421--456},
 volume = {21},
 number = {4},
 journal = {Economic and Industrial Democracy}
}


@unpublished{Visser.2002,
 abstract = {In this paper I discuss the recent Europeanisation of employment policy. In the centre of my analysis will be the European Employment Strategy, its underlying philosophy towards social and emplyoment policy, its method of achieving common goals in Europe, and its implementation, policy learning effectgs and limitations in one particluar case, the Netherlands. A brief comparison with the OECD Jobs Strategy helps to illustrate the political nature of the process, the common focus on supply-side policies, but with a stronger emphasis on activation policies. My choice to concentrate on employment rather than social policy is justified in the context of the current attempt among European policy makers to redefine social policy as employment policy and present paid employment as a key element in the stratey against social exclusion and poverty. Two issues will be discussed at some length: low quality service employment and its implications for skill development, income, and welfare; and the limited net effectiveness of acrive labour market policies. This raises questions about the current exclusive emphasis on supply-side policies in European employment policy.},
 author = {Visser, Jelle},
 year = {2002},
 title = {Is the European Employment Strategy the Answer? Paper prepared for the NIG Workshop: {\textquotedbl}Governability in Post-Industrial Societies: The European Experience{\textquotedbl}},
 keywords = {Employment strategy;Luxembourg Process;OECD;omc;surveillance},
 address = {Utrecht School of Governance and 26-27 April 2002}
}


