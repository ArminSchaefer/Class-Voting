@article{Marsh.1998,
 abstract = {Reif and Schmitt argued that elections to the European Parliament should be understood as second-order national elections, and advanced several predictions about the results of such elections. Those concerning the impact of government status, party size, party character and the national ecection cycle on electoral performance are examined here using data on four sets of EP elections. In addition, the consequences of EP elections for the next national elections are explored. The analysis demonstrates the validity of most of Reif and Schitt's original propositions, and furhter refines their analysis of the relationship between European and subsequent national elections. However, all propositions hold much more effectivelyi n countries where alternation in government is the norm, suggesting that the distinction between first and second-order elections may not be so clear cut as Reif and Schmitt imagined.},
 author = {Marsh, Michael},
 year = {1998},
 title = {Testing the Second-Order Election Model after Four European Elections},
 keywords = {EP;parties},
 pages = {591--607},
