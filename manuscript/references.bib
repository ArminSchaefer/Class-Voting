@article{Bhatti.2012b,
 abstract = {Electoral turnout has been declining at national elections in almost all Western democracies. European Parliament (EP) elections have followed the same trend. We utilize a previously suggested method for separating the effect of generation, age and period and show that a major part of the decline can be attributed to the difference in turnout between pre- and post-baby-boomer generations though there are substantial differences across countries. Age has a curvilinear effect on turnout even when generation is taken into account, but the age composition has remained relatively stable over time. We utilize the estimated coefficients to predict future changes in turnout as a result of the expected shifts in the generational and age compositions over the next 30 years. The results point to a continued decline in turnout to EP elections $\backslash$textendash especially between the years of 2020 and 2040.},
 author = {Bhatti, Yosef and Hansen, Kasper M.},
 year = {2012},
 title = {The effect of generation and age on turnout to the European Parliament -- How turnout will continue to decline in the future},
 url = {https://linkinghub.elsevier.com/retrieve/pii/S0261379411001363},
 urldate = {2020-01-23},
 pages = {262--272},
 volume = {31},
 number = {2},
 issn = {0261-3794},
 journal = {Electoral Studies},
 doi = {10.1016/j.electstud.2011.11.004}
}


