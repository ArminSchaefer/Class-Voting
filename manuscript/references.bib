@article{Laver.1998,
 abstract = {This review deals with the making and breaking of governments in 'minority legislatures' in which no political party controls a majority of seats. It looks at both a priori and empirical approaches to analyzing government formation, at the applicatoin of both cooperative and noncooperative game-theoretic models, and at the impact of both office-seeking and policy-seeking assumptions about the motivations of politicians. Substantive themes covered include the partisan composition of both minority and majority cobinets, the allocaion of cabinet portfolios between parties, and the uration of cabinets in minority legislatures. The forward in this fields is identified in terms of the need for more dynamic models that see government formation as a complex system within the broader context of party competition as a whole, and for models that take fundamental caccount of intraparty politics in their description of the strategic behavior of political parties.},
 author = {Laver, Micheal},
 year = {1998},
 title = {Model of Government Formation},
 keywords = {coalition formation;cooperative games;game theory;minimal winning coalition;non-cooperative games;office seeker;party competition;policy seeker;Riker},
