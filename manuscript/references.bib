@article{Schmidt.2000b,
 abstract = {What is scope for autonomous action of the European Commission? Its independence is much more contentious than that of the European Court of Justice, which is generally considered quite autonomous. While the literature on the commission focuses predominantly on its ability to use its agenda-setting powers, the Commission's other means to influence European integration have been less well established. In this paper, I demonstrate how the commission can use its role as a guardian of the Treaty to coax the counicl of Ministers into action. In addition to agenda setting, the commission can manipulate the Council's default condition, or change the preferences of some of its member states. Thereby the Commission my achieve decisions from the counicl that would not have come about had the Commission only agenda-setting powers at its disposal. Effectively, the Commission here uses the greater autonomy of the European Court strategically for its own ends.},
 author = {Schmidt, Susanne K.},
 year = {2000},
 title = {Only an Agenda Setter? The European Commission's Power over the Council of Ministers},
 keywords = {agenda setting;European Commission;European Court of Justice;Kommission},
 pages = {37--61},
 volume = {1},
 number = {1},
 journal = {European Union Politics}
}


@article{Schmidt.2001,
 abstract = {Dieses Papier bestimmt f{\"u}nf vermittelnde Faktoren, welche Abweichungen migliedstaatlicher Politikanpassung als Antwort auf den {\"o}konomischen Druck der Globalisierung und Europ{\"a}isierung (im Unterschied zu europ{\"a}ischer Integration, verstanden als Einflu{\ss} von Entscheidungen der EU-Ebene auf Politiken und Insitutionen auf nationaler Ebene) erkl{\"a}ren: {\"o}konomische Verwundbarkeit, politisch-institutionelle Kapazit{\"a}t, politische Altlasten, Politikpr{\"a}ferenzen und Diskurs. Zus{\"a}tzlich zu diesen Faktoren werden vier institutionelle Anpassungzw{\"a}nge ausgeleuchtet: wenn ein EU-Modell n{\"o}tig ist, wenn es empfohlen ist, wenn es vorgeschlagen ist, bzw. wenn dies nicht der Fall ist. Dies soll zu einer Erkl{\"a}rung der unterschiedlichen Ergebnisse der Europ{\"a}isierung, n{\"a}mlich Politiktr{\"a}gheit, {\"U}bernahme oder Transformation, beitragen. Zur Illustration liegt der Schwerpunkt auf den Politikreaktionen dreier L{\"a}nder (Frankreich, Gro{\ss}britannien und Deutschland) in Sektoren wie Geldpolitik, Finanzdienstleistungen, Telekommunikation, Elektrizit{\"a}t, Transport, Umwelt und Besch{\"a}ftigung.},
 author = {Schmidt, Vivien A.},
 year = {2001},
 title = {Europeanization and the Mechanics of Economic Policy Adjustment},
 keywords = {comparative public policy;economic policy;Europeanization;sectoral governance, globalization},
 volume = {5},
 number = {6},
 journal = {European Integration online Papaers (EIoP) http://eiop.or.at/eiop/texte/2001-006a.htm}
}


