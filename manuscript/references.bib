@article{LaPorte.2002,
 abstract = {Guter {\"U}berlick und Vergleich von EES und Social inclusion. Vor allem interessant mit Blick auf benchmarking und die verwendeten Indikatoren. Trifft sich in der Einsch{\"a}tzung der Entstehung und Wirkung der Besch{\"a}ftigungspolitik mit meinen Vermutungen, insbesondere was die Kompromissbildung in Essen angeht und die Abh{\"a}ngigkeit einer Wirkung von der nationalen Konstellation.

This article addresses the question of the relevance of the most recent soft policy instrument of the EU, the open method of coordination (OMC), for organising actions at European level in politically sensitive areas. IN addition to describing  its origins and operational principals, we will compare its application to the areas of employment and social inclusion. Two hypotheses make up the structure of the text. The first is that the discourses produced in the frameworkof OMC in the areas of employment  and social inclusion are braod enough to cater the different welfare models, but that the changes to be made by the Member States to be in line with the European discourses differ considerably, dependingon their welfare state family and their initial situation. The second is that the form of OMC is variable, depending on policy area. Our conclusions confirm both these hypotheses.},
 author = {de {La Porte}, Caroline},
 year = {2002},
 title = {Is the Open Method of Coordination appropriate for organising activities at European level in sensitive policy areas?},
 keywords = {benchmarking;Essen Follow-up;guidelines;indicators;omc;social inclusion;surveillance},
