@article{Klein.2005,
 abstract = {Die Wahlbeteiligung bei Bundestagswahlen wies in den letzten Jahrzehnten einen r{\"u}ckl{\"a}ufigen Trend auf. Die vorliegende empirischen Analysen der Mechanismen hinter diesem R{\"u}ckgang sch{\"o}pfen das Analysepotential der verf{\"u}gbaren Trendaten nur unvollkommen aus. Am Beispiel der Politbarometer-Befragungen der Jahre 1977-2002 wird gezeigt, wie man Trenddaten mit hilfe der Mehrebenenanalyse einer stringenteren Auswertung unterziehung kann. Die r{\"u}ckl{\"a}ufige Verbreitung der Parteiidentifikation und die zunehmende Unzufriedenheit mit den politischen Parteien erweisen sich dabei als Hauptursachen der r{\"u}ckl{\"a}ufigen Beteiligungsbereitschaft. Die Mobilisierungswirkung von Wahlk{\"a}mpfen nehmen {\"u}ber die Zeit zu.},
 author = {Klein, Markus},
