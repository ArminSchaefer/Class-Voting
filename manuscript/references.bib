@unpublished{Ostheim.2002,
 abstract = {Auch rund f{\"u}nf Jahre nach der Verabschiedung derersten besch{\"a}ftigungspolitischen Leitlinien im Rahmen des Luxemburger Prozesses ist noch offen, inwieweit die Leitlinien und Empfehlungen die mitgliedstaatliche Arbeitmarktpolitik bestimmen. Dieser Beitrag sucht diese Frage am Beispiel Deutschlands zu beantworten.

Ein {\"U}berblick {\"u}ber die besch{\"a}ftigungspolitischen Leitlinien zeigt, dass diese teilweise auf unterschiedlichen Auffassungen der Ursachen von Arbeitslosigkeit und niedrige Besch{\"a}ftigungsquoten basieren und verschiedenen Strategien der Steigerung der Besch{\"a}ftigunsquote folgen. Daher finden sich neben den relativ konkreten und quantifizierten Vorgaben einiger Leitlinien - insbesondere zu aktivierenden Ma{\ss}nahmne der Arbeitsmarktpolitik, dem Schwerpunkt der Leitlinien - auch solche, die den MS geges{\"a}tzliche Ma{\ss}nahmen erlauben.

Die deutschen policies zeigen, dass von einer Determination der nationalstaatelichen Arbeitsmarkt- und Besch{\"a}ftigungspolitik durch die Vorgaben von europ{\"a}ischer Ebene nicht gesprochen werden kann. Punktuell lassens sich jedoch Auswirkungen feststellen. Diese Effekte sind insbesondere bei den quantifierzierten Vorgaben zur 'Verbesserung der Besch{\"a}ftigungsf{\"a}higkeit' und konkreten Empfehlungen auszumachen. Es ist zudem ein parteipolitischer Effekt erkennbar: Die dem Projekt einer 'europ{\"a}ischen' Besch{\"a}ftigungspolitik im Vergleich zur Vorg{\"a}ngerregierung aufgeschlossenere rot-gr{\"u}ne Bundesregierung ber{\"u}cksichtigte die Vorgaben der Leitlinien und Empfehlungen eher als die christ-liberale Koalition.},
 author = {Ostheim, Tobias and Zohlnh{\"o}fer, Reimut},
 year = {2002},
 title = {Europ{\"a}isierung der deutschen Arbeitsmarkt- und Besch{\"a}ftigungspolitik? Zes-Arbeitspapier Nr. 9/02},
 keywords = {activation;EES;Jobs Study;Luxembourg Process;NAP;policy learning;Third Way},
 address = {Universit{\"a}t Bremen}
