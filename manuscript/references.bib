@article{Lacher.1999,
 abstract = {The postwar order of embedded liberalism conformed neither in its domestic nor its international aspect to the model of a society with embedded markets which Polanyi envisaged in The Great Transformation. Embedded liberalism neither banished the profit move from the centre of the organisation of material life, nor did it render markets into a mere accessory of economic life. Welfare capitalism was not a 'society with markets', but a society in which the logic of capitalism had penetrated to the very core of social organisation. Despite the increasing security and wealth of many groups of the working classes, we have to distinguish the strengthening of the social position and economic bargaining power of the subordinate classes from the transcendence of 'economic society'. Despite the more active role for the state, moreover, the market remained the 'fount and matrix' of postwar Western civilisation. Finally, despite the limited national protectionism which was instituted internationally through the Bretton Woods institution, society remained in the grip of the market economy. Postwar Western societies were not masters of their fate, with markets subordinated to socially defined goals and values.},
 author = {Lacher, Hannes},
 year = {1999},
 title = {Embedded Liberalism, Disembedded Markets: Reconceptualising the Pax Americana},
 keywords = {Bretton Woods;decommodification;embedded liberalism;Polanyi},
 pages = {343--360},
 volume = {4},
 number = {3},
 journal = {New Political Economy}
}


