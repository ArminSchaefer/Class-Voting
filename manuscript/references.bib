@article{Meguid.2005,
 abstract = {What acounts for variation in the electoral success of nicht parties? Although institutional and sociological explanations of singly-issue party strenghth have been dominant, they tend to remove parties from the analysis. in this article, I argue that the behavior of mainstream parties influences the electoral fortunes of the new, niche party actors.  In contrast to standard spatial theories, my theory recognizes that party tactics work by altering the salience and ownership of issues for political competition, not just party issue positions. It follows that niche party support can be shapted y both proximal and non-proximal compeitiors. Analysis of green and radical right party vote in 17 Western European countries from 1970 to 2000 confirms that mainstream party stregies matter; the modified spatial theory acounts for the failure and succes of niche parties across countries nad over time better than institutional, sociological, and even standard spatial explanations.},
 author = {Meguid, Bonnie M.},
 year = {2005},
 title = {Competition Between Unequals: The Role of Mainstream Party Strategy in Niche Party Success},
 keywords = {Downs;parties;party systems},
 pages = {347--359},
