 isbn = {978-1032125787}
}


@article{Husted.1997,
 abstract = {This paper examines the claim that expansion of the voting franchise has been an important factor in the growth of government. State government spending and state and local spending are explained using a panel of 46 states for 1950-88. Elimination of poll

taxes and literacy tests led to higher turnout, particularly among the poor, and a poorer pivotal voter. As predicted, we find that

these changes, a fall in the income of voters relative to state income, and the ouster of Republicans from state government led to

a sharp rise in welfare spending but no change in other spending.},
 author = {Husted, Thomas A. and Kenny, Lawrence W.},
 year = {1997},
 title = {The Effect of the Expansion of the Voting Franchise on the Size of Government},
 keywords = {turnout},
 pages = {54--82},
 volume = {105},
 number = {1},
 journal = {Journal of Political Economy},
 file = {Husted-Kenny 97:Attachments/Husted-Kenny 97.pdf:application/pdf}
}


@article{Huttig.1992,
 abstract = {Gegenstand dieser wissenschaftshistorischen Studie sind die Schulbildungsprozesse am Marburger Institut f{\"u}r wissenschaftliche Politik zwischen 1951 und 1975. Um den Leiter Wolfgang Abendroth entstand in den 50er und 60er Jahren eine wissenschaftliche Schule, die gemeinsame politische Wertmuster und das Leitbild einer {\textquotedbl}Kritischen{\textquotedbl} Politikwissenschaft mit entschiedenem Praxisbezug teilte und sich im zeitgen{\"o}ssischen Spektrum des Faches als linke Variante des demokratiewissenschaftlichen Paradigmas etablierte. Mit Forschungsprogrammen zur Geschichte der Arbeiterbewegung und zur Verbands-, Parteien- und Wahlforschung entwickelte sie ein ausgepr{\"a}gtes Profil und erschlo{\ss} sich den Bereich der politischen Bildung als eines ihrer zentralen Berufsbilder.

Die universit{\"a}ren Politisierungsprozesse in der zweiten H{\"a}lfte der 60er Jahre haben die Ambivalenzen von Wissenschaftsprogramm und Praxisorientierung im Marburger Denkkollektive aufbrechen lassen. Im Ergebnis setzte sich Mitte der 70er Jahre eine Teilstr{\"o}mung als orthodoxmarxistische, parteigebundene {\textquotedbl}Marburger Schule{\textquotedbl} durch, deren Bedeutung f{\"u}r die wissenschaftliche Entwicklung des Faches marginal geblieben ist und die die Existenz anderer Traditionsstr{\"a}nge {\"u}berdeckt hat.},
 author = {H{\"u}ttig, Christoph and Raphael, Lutz},
 year = {1992},
 title = {Die {\textquotedbl}wissenschaftliche Politik{\textquotedbl} der {\textquotedbl}Marburger Schule(n){\textquotedbl} im Umfeld der westdeutschen Politikwissenschaft 1951-1975. Ein Beitrag zur Geschichte der Disziplin},
 pages = {427--454},
 volume = {33},
 number = {3},
 issn = {0032-3470},
 journal = {Politische Vierteljahresschrift}
}


@incollection{Hvinden.2001,
 abstract = {In this chapter we examine how the relationship between employment and social protection policies was restructured in Western Europe in the course of the 1990s. We address the changes that took place on two different levels. First, we analyse the new idas about the relationship between employment and social security arrangements, as these ideas were expressed through two supranational bodies: the Organisation fro Economic Co-operation and Development (OECD) and the European Union (EU). Second, we are interested in the extent to which the new policy discourse on these issues was matched by changes in policy practice in a number of European countries, i.e. the measures and provisions aimed at people out of work.},
