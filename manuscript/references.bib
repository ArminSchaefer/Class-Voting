@article{Noordzij.2021,
 abstract = {Why is discontent with politicians highest among less-educated citizens? Supplementing explanations concerning a lack of resources and knowledge, we examine the cultural distance to many a politician perceived by this group. Inspired by qualitative studies mapping the worldviews of people from the lower social strata, we explore less-educated citizens' perceptions of politicians using in-depth (group) interviews carried out in various regions of the Netherlands (n~=~26). Our analysis indicates that this group regards politicians as culturally distant {\textquotedbl}others{\textquotedbl} and that this perception goes hand in hand with specific negative evaluations of politicians. This improves our understanding of the much-reported political discontent of these citizens. In moving beyond the often mentioned unspecific divide between the {\textquotedbl}people{\textquotedbl} and the {\textquotedbl}elite{\textquotedbl}, our analysis reveals that our interviewees: (i) consider politicians to be insensitive to the lived experiences of the {\textquotedbl}common{\textquotedbl} people, and therefore, question their legitimacy and the policies they propose; (ii) resent their communication styles, which they describe as {\textquotedbl}beating about the bush{\textquotedbl} and perceive to be emblematic of indecisiveness and a lack of integrity; and (iii) accuse them of superiority signaling, inspiring feelings of misrecognition and opposition. We conclude with detailing the implications of our findings for (future) research.},
 author = {Noordzij, Kjell and de Koster, Willem and {van der Waal}, Jeroen},
 year = {2021},
 title = {{\textquotedbl}They don't know what it's like to be at the bottom{\textquotedbl}: Exploring the role of perceived cultural distance in less-educated citizens' discontent with politicians},
 keywords = {class;representation},
 pages = {566--579},
 volume = {72},
 issn = {1468-4446},
 journal = {The British Journal of Sociology},
 doi = {10.1111/1468-4446.12800},
 file = {Noordzij et al. 20:Attachments/Noordzij et al. 20.pdf:application/pdf}
}


