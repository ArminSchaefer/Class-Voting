@article{Roteutscher.2016,
 abstract = {Die Wahlbeteiligung in Deutschland ist in den letzten beiden Jahrzehnten nicht nur stark gesunken, sondern auch sozial ungleicher geworden. Mithilfe eines neuen Datensatzes zur r{\"a}umlichen Schwerpunktsetzung im Wahlkampf in Frankfurt am Main zeigen wir, dass Parteien asymmetrisch mobilisieren. Sie halten Wahlkampfveranstaltungen dort ab, wo die Wahlbeteiligung in der Vergangenheit h{\"o}her war und wo sie erfolgreich waren - und vermeiden sozialstrukturell benachteiligte Stadtteile mit niedriger Wahlbeteiligung. Die Analyse von Individualdaten best{\"a}tigt, dass durch den Wahlkampf meist diejenigen erreicht werden, die politisch interessiert sind und der jeweiligen Partei nahestehen. Eine besondere Anstrengung, fr{\"u}here Nichtw{\"a}hler*innen zu mobilisieren, l{\"a}sst sich weder anhand der Aggregat- noch der Individualdaten nachweisen.},
 author = {Ro{\ss}teutscher, Sigrid and Sch{\"a}fer, Armin},
 year = {2016},
