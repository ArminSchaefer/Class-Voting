@article{Fligstein.2002,
 abstract = {As institutions and governance structures develop in modern markets, they then to 'feed back' onto economic activity. Through such feeedback loops, market and political arenas ccan develop symbiotically  into relatively coherent 'fields' that gradually embed actors' orientations and activities. Using these insights, this article develops and test a throy of European integration focusing on the case of the European Community, the first pillar of the EU. Traders, organized interests, courts, and the EC's policy-making organs, over time, have produced a self-sustaining causal system that has driven the construction of the European market and polity. The generality of the explanation to a sociology of markets and polity-building projects is duscussed in the conclusion.},
 author = {Fligstein, Neil and {Stone Sweet}, Alec},
 year = {2002},
