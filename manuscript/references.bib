@article{Majone.1991,
 abstract = {Because events occur too fast and ideas mature too slowly for responses to be designed anew for each pressing problem, policy innovation often relies on pre-existing models, foreign or domestic. This seems to be especially true for regulation policymaking, since public regulation is typically introduced in conditions of crisis. In this paper we examine several cases of policy innovation in the area of economic and social regulation where the influence of foreign models is quite clear: the development of competition policy in Europe in the 1950s, the growth of European Community regulation, and the impact of American deregulation movement on the telecommunication policies of different European countries. The analysis shows that while utilization of pre-existing models is a common feature of policy innovation, such models are not literally translated into current policy. More or less extensive adaptations to a particular political, institutional and economic context are usually required. We also identify two distinct ways- push or pull- in which foreign models can affect domestic policy.},
 author = {Majone, Giandomenico},
 year = {1991},
 title = {Cross-National Sources of Regulatory Policy making in Europe and the United States},
 keywords = {diffusion;policy learning},
 pages = {79--106},
 volume = {11},
 journal = {Journal of Public Policy}
}


@article{Majone.1994,
 abstract = {Privatization and deregulation have created the conditions for the rise of the regulatory state to replace the dirigiste state of the past. Reliance of regulation - rather than public ownership, planning or centralised administration - characterises the methods of the regulatory state. This studdy examines the growth of regualtion in Europe, at the nation and Community levels. It stresses the advantages of the mode of policy making, but also recognises its problems. It is suggested that policial accountabilty can be ensured by a variety of substantive and procedural controls, among which judicial review is especially important. Executive oversight and co-ordination may be improved by using new tools of public management like the regulatory budget or the regulatory clearing house.},
 author = {Majone, Giandomenico},
 year = {1994},
 title = {The Rise of the Regulatory State in Europe},
 keywords = {delegation},
 pages = {77--101},
 volume = {17},
 number = {3},
 journal = {West European Politics}
}


@article{Majone.1996,
 abstract = {Why is it necessary to delegate certain task and thus remove them from direct political control and accountability? The general explanation is time inconsistency of political preferences, that is, if there is discretion the addressees of policies will expect future (opportunistic) change by politicians concerned with upcoming elections. Delegation increases credibility and transforms short-termism into longer term concerns.},
 author = {Majone, Giandomenico},
 year = {1996},
 title = {Temporal Consistency and Policy Credibility: Why Democracies Need Non-Majoritarian Institutions},
 keywords = {delegation;time inconsistency},
 volume = {RSC No. 96/57},
 journal = {EUI Working Paper.}
}


@article{Majone.1997,
 abstract = {The new European agencies have been denied powers normally granted to regulatory bodies. In most cases their functions are limited to providing information and networking with other institutions. Thus, they seem to be doomed to play an auxiliary role; but they could also turn their statutory limitations into opportunities by developing information-based modes of regulation more in tune with currenct economic and political  conditions than the coerceive powerds denied to them. In fact, a good deal of empirical evidence suggests that regulation by information is often more effeective than direct regulation. However, information can change expectations and behaviour only if it is credible. In turn, credibility depends crucially on reputation. It is suggested that networking could help agencies to enhance their reputation and indepedence. An agnecy that sees itslef as part of a trnsantional network is more motivated to defend its independence and professional integrity: unprofessional or polically motivated behaviour would compromise its international reputation and make co-operation more difficult in the future. Actually, the network may beviewed as an intangible asset carrying a reputation that is beneficial for efficient information exchange.},
 author = {Majone, Giandomenico},
 year = {1997},
 title = {The new European agencies: regulation by information},
 keywords = {governance;governance by persuasion;information strategies;networks;Regulation;soft law},
 pages = {262--275},
 volume = {4},
 number = {2},
 journal = {Journal of European Public Policy}
}


@article{Majone.1998,
 abstract = {Arguments about Europe's democratic deficit are really arguments about the nature and ultimate goals of the integration process. Those who assume that economic integration must lead to political integration tend to apply to European institutions standards of legitimacy derived from the theory and practice of parliamentary democracies. We argue that such standards are largely irrelevant at present. As long as the majority of voters and their elected representatives oppose the idea of a European federation, while supporting far-reaching economic integration, we cannot expect parliamentary democracy to flourish in the Union. Economic integration without political integration is possible only if politics and economics are kept as separate as possible. The depoliticisation of European policy-making is the price we pay in order to preserve national sovereignty largely intact. These being the preferences of the voters, we conclude that Europe's `democratic deficit' is democratically justified. The expression `democratic deficit,' however, is also used to refer to the legitimacy problems of non-majoritarian institutions, and this second meaning is much more relevant to a system of limited competences such as the EC. Now the key issues for democratic theory are about the tasks which may be legitimately delegated to institutions insulated from the political process, and how to design such institutions so as to make independence and accountability complementary and mutually supporting, rather than antithetical. If one accepts the `regulatory model' of the EC, then, as long as the tasks delegated to the European level are precisely and narrowly defined, non-majoritarian standards of legitimacy should be sufficient to justify the delegation of the necessary powers.},
 author = {Majone, Giandomenico},
 year = {1998},
 title = {Europe's `Democratic Deficit': The Question of Standards},
 pages = {5--28},
 volume = {4},
 number = {1},
 issn = {1468-0386},
 journal = {European Law Journal},
 doi = {10.1111/1468-0386.00040}
}


@article{Majone.2000,
 abstract = {The article addresses two specific threats to credibility: the mismatch between  the Community's highly complex and differentiated regulatory tasks and the available administrative instruments; and the problem of credible commitment caused by the increasing level of politicisation and parliamentarization of the Commission. The soluation to both sets of problems, it is argued, may be found in a more far-reaching delegation of power to independent European agnecies embedded in transnational networks of natonal regulators and international organizations. Recent theoretical advances in the area of instituitonal design and procedureal control suggest that such networkds could be made to satisfy all reasonable requirements of subsidiarity, accountability and efficiency.},
 author = {Majone, Giandomenico},
 year = {2000},
 title = {The Credibility Crisis of Community Regulation},
 keywords = {delegation;legitimacy},
 pages = {273--302},
 volume = {38},
 number = {2},
