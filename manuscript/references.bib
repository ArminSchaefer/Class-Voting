 abstract = {Traditional welfare policy areas, such as employment oplicy and social protection, have recently been defined as an area of common concern amongthe EU member states and are no longer exclusively a national responsibility. In these areas, however, the ordinary supranational legal method has not met political support. Therefore, new forms of regulation and governance, partly based on other mchanisms of policy coordination, are emerging. The paper describes the system of governance that has developed the last years in the field of EU employment  policy (the Luxembourg process) and more recently been extended to other policy areas, such as social inclusion (the open method of coordination) The aim is to identify the mechanisms of policy coordination and the principles of governance on which this system of solft law governance rests. The paper also adresses how this new system of governance shapes the actions and outlooks of actors involved and how it affects the dynamics within and between institutions. The paper argues that laso non-binding regulation may have a substantial impact on national policies, however long-term and incremental.},
 author = {Jacobsson, Kerstin},
 year = {2001},
 title = {Employment and Social Policy Coordination. A New System of EU Governance},
 keywords = {diffusion;Employment strategy;Essen Follow-up;governance;Luxembourg Process;Neo-voluntarismus;omc;policy learning;soft law}
}


@incollection{Jacobsson.2002,
 abstract = {Konzentriert sich auf die Umsetzung durch die nationale B{\"u}rokratie. Insgesamt wird der Einfluss der EES auf die nationale Politik als durchweg gering eingesch{\"a}tzt.

This chapter focuses on the National Action Plan (NAP) procedure and its effects inside the Member States. Based mostly on interviews and field observations in Denmark and Sweden, it identifies a number of implentation problems concerning such things as the integration of the NAP process into the everyday agenda of national ministries and state agencies, its connections to the budgetary process, its relation to the regional and local levels of labour market administration and the European Social Fund (ESF) projects etc. ...the question here is to what extent the 'regular' policy activites are actually affected, and how the possible effects do come about. A second question to be addressed concerns to what extent the NAP procedure is at all integrated withthe domestic political process. Finally, the chapter outlines some possibilities for improvement.},
 author = {Jacobsson, Kerstin and Schmid, Herman},
 title = {Real integration or just formal adaptation? - On the implementation of the National Action Plans for Employment},
 keywords = {Denmark;NAP;national impact;omc;Sweden},
 pages = {69--95},
 publisher = {{PIE Lang}},
 editor = {de {La Porte}, Caroline and Pochet, Philippe},
 booktitle = {Building Social Europe through the Open Method of Co-ordination},
 year = {2002},
 address = {Br{\"u}ssel u.a.}
}


@unpublished{Jacobsson.2003,
 abstract = {The Amsterdam treaty defined employment policy as an area of common concern among the EU member states and gave a procedure for the coordination of member state policy based on cyclical processes, soft law, and peer review. Forms of governance based on other mechanisms of policy coordination than supranational law-making are emerging. This paper investigates to what extent this type of soft governance is supportive of a deliberative mode of policy-making. The paper fucuses in particular on the role of the recently established EU committees for fostering dialogue, notably the Employment Committee. it also investigates to what extent modification of outlooks and positions and the adoption of common frames of references take place.},
