@article{Dunleavy.1997,
 abstract = {The progressive centralization of the European Union is analysed unsing an array of public choice models, operating at the levels of social forces and institutional actors, and covering both the supply of centralization and the demand for it. The 'tripple state thesis' argues that large-scale business systematically seeks to insulate decisions of key importance for profit levels from electoral scrutiny. A werlfare-maximizing approach argues that European citizens have accepte chagnes in the level at which decisions are made in order to accomplish goals more efficiently, by matching institutional scales to problem characteristics. In the bureau-shaping model, EU bureaucrats have played a key role by wanting to deliver centralization while maintaining a minimal organizational apparatus. And the transaction costs account sets out why member state governmentes have incentives to delegate (partial) powers upwards, in order to achieve deniability for tough decisions and to facilitate otherwise difficult pre-commitments. Two key implications flow from the overall analysis: the drift to Brussels' is likely to continue; and the EU's 'democratic deficit' will be a permanent feature of institutional arrangements.},
 author = {Dunleavy, Patrick},
 year = {1997},
 title = {Explaining the Centralization of the European Union: A Public Choice Analysis},
 keywords = {blame avoidance;blame shifting;credit claiming;Demokratiedefizit;public choice;Zentralisierung},
