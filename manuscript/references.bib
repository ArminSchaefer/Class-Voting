@incollection{Falkner.imErscheinenb,
 abstract = {In the 1991 Intergovernmental Coference, conflicts over social policy endangered the whole treaty reform package. The path-breaking innovations that finally occurred (although initally for eleven members only) regarding both competence and procedures made the Maastricht Treaty a turning point for European social policy. For these reasons, the Maastricht Social Agreement represnets an important case for testing the propositon that dynamics beyond power and intergovernmental bargaining can play a decisimve role in EU treaty reform. The insight that both a Euro-level process of preference formationa and Euro-level actors mattered here indicates that state-of-the-art research mustpay attention to such dynamics as potentially relvelantfactos in all instances of EU treaty reform. EU reform, even at theconstitutional level of treaty change and even in formal IGSs, can be much less 'intergovernmental' than the name 'Intergovernmental Conference' suggests.},
 author = {Falkner, Gerda},
 title = {How Intergovernmental Are Integovernmental Conferences? An Example from the Maastricht Treaty Reform},
 keywords = {EU decision-making;Intergovernmental Conferences;Maastricht Treaty;social policy;social protocol;treaty reform},
 editor = {Falkner, Gerda},
