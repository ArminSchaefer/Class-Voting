@article{Sartori.1970,
 abstract = {The remedy to conceptual stretching resides in our combined ability 1) to develop the discipline along a medium level of abstraction with better intermediate categories, and 2) to maneuver, both upwards and downwards, along a ladder of abstraction in such a way as to bring together assimilation and differentiation, a relatively high explanatory power and a relatively precise desccriptive content, macro-theory and empirical testing. To be sure, no level of analysis can be exactly translated and converted into the next level. In this sense, something is always lost (and gained) along the ladder. But a disciplined use of terms and procedures of comparison generates, at each level, sets of propositions which either reinforce or contradict the propositions of the neighboring levels.},
 author = {Sartori, Giovanni},
 year = {1970},
 title = {Concept Misformation in Comparative Politics},
 keywords = {comparative method;conceptual stretching;ladder of abstraction},
 pages = {1033--1053},
