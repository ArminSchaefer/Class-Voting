@misc{Ekengren.2000,
 abstract = {By analysing the dynamics of European employment cooperation, this article aims to contribute to an explantion of the constitutionalization of EU governance. By specifying the governance concept in relation to an empirically well-founded policy area, the article illustrates how a complex system of multi-level governance changes the conditions for the future constitutionalization of the EU. We have chsen to examine the EU employment oplicy due to its complexity with a broad participation of actors on both local, national and European levels and its variety of governance instruments emerging from both intergovernmental and supranational methods. Eurpoean employment policy is also thefirst and prime example of the new soft law approach to EU policy-making.},
