@article{EuropeanSocialSurvey.2019,
 abstract = {The European Social Survey (ESS) is an academically-driven multi-country survey, which has been administered in over 30 countries to date. Its three aims are, firstly -- to monitor and interpret changing public attitudes and values within Europe and to investigate how they interact with Europe's changing institutions, secondly - to advance and consolidate improved methods of cross-national survey measurement in Europe and beyond, and thirdly - to develop a series of European social indicators, including attitudinal indicators. In the ninth round, the survey covers 19 countries and employs the most rigorous methodologies. From Round 7 it is funded by the Members, Observers and Guests of ESS European Research Infrastructure Consortium (ESS ERIC) who represent national governments. Participating countries directly fund the central coordination costs of the ESS ERIC, as well the costs of fieldwork and national coordination in their own country. The survey involves strict random probability sampling, a minimum target response rate of 70{\%} and rigorous translation protocols. The hour-long face-to-face interview includes questions on a variety of core topics repeated from previous rounds of the survey and also two modules developed for Round 9 covering Justice and Fairness in Europe and the {\textquotedbl}Timing of Life{\textquotedbl} (the latter is a repeat of a module from Round 3).},
 author = {{European Social Survey}},
 year = {2019},
 title = {European Social Survey (ESS), Round 9 - 2018},
 url = {https://www.europeansocialsurvey.org/data/download.html?r=9},
 keywords = {Demographics;Distributive;Ethnic;Fairness;Human Values;National;participation;Political Interest;Procedural Justice;Religious Allegiances;Social Exclusion;Social Trust;Socioeconomics;Socio-political Orientations;the Life Course;Timing of Key Life Events},
 urldate = {2020-08-06}
}


@misc{EuropeanSocialSurveyERIC.,
 abstract = {The European Social Survey (ESS) is an academically-driven multi-country survey, which has been administered in over 30 countries to date. Its three aims are, firstly -- to monitor and interpret changing public attitudes and values within Europe and to investigate how they interact with Europe's changing institutions, secondly - to advance and consolidate improved methods of cross-national survey measurement in Europe and beyond, and thirdly - to develop a series of European social indicators, including attitudinal indicators.

The ESS Data Download Wizard gives access to cumulative data from countries that have been included in the integrated ESS files in two or more rounds, and all variables from questions that have been asked in more than one round. From Round 7, ESS is funded by the Members, Observers and Guests of ESS European Research Infrastructure Consortium (ESS ERIC) who represent national governments. Participating countries directly fund the central coordination costs of the ESS ERIC, as well the costs of fieldwork and national coordination in their own country.

The survey involves strict random probability sampling, a minimum target response rate of 70{\%} and rigorous translation protocols. The hour-long face-to-face interview includes questions on a variety of core topics repeated from previous rounds of the survey as well as two or three rotating modules.},
 author = {{European Social Survey ERIC}},
 title = {European Social Survey (ESS), Cumulative Data Wizard},
