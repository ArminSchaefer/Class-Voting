@article{Garry.2005,
 abstract = {Are referendums on EU treaties decided by voters' attitudes to Europe (the 'Issue-voting explanation') or by voters' attitudes to their national political parties and incumbent national government(the second-order election model' explanation)? In one scenario, these referendums will approximate to deliberative processes that will be decided by people's views of the merits of European integration. In the other scenario, they will be plebiscites on the perfomance of national governments. We test the wo competing explanations of the determinants of voting in EU referendums using evidence from the two Irish referendums on the Nice Treaty. We find that hte issue-voting model outperforms the second-order model in both referendums. However, we also find that issue-voting was particularly imporatnat in the more salient and more intense seond referendum. Most strikingly, attitudes to EU enlargement were much stronger predictors of vote at Nice 2 than at Nice 1. This finding about the rise in importance of attitudes to the EU points to the importance of compaigning in EU referndums.},
 author = {Garry, John and Marsh, Michael and Sinnott, Richard},
 year = {2005},
 title = {{\textquotedbl}Second-order{\textquotedbl} versus {\textquotedbl}Issue-voting{\textquotedbl} Effects in EU Referendums. Evidence from the Irish Nice Treaty Referendums},
