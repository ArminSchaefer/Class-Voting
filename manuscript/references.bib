@article{Vanberg.2008,
 abstract = {Das Problem ist, dass nicht genannt wird, auf welchen minimalen Voraussetzungen sich die B{\"u}rger 'freiwillig einigen' k{\"o}nnten. Einerseits wird davon ausgegangen, dass Sonderinteressengruppen die Politik vergiften und der Staat exzessiv w{\"a}chst. Andererseits wird unterstellt, dass sich alle konfliktfrei auf einige Grundprinzipien einigen k{\"o}nnten - ohne zu erkl{\"a}ren, wie dies geschehen soll. Nimmt man Konflikte als Ausgangspunkt der Demokratie kann diese Position nicht {\"u}berzeugen.



The principal claim of this paper is that liberalism and democracy are not only compatible ideals, as F.A. Hayek has suggested, but rather complementary ideals. The argument in support of this claim is based on a distinction between three different levels at which liberalism and democracy can be compared, the level of their institutional embodiment, the level of their principal ideals, and the level of their underlying normative premise. It is argued that liberalism and democracy share as their common normative foundation the principle of individual sovereignty, and that their respective core ideals, the liberal principle of private autonomy and the democratic principle of citizen sovereignty, can be best understood as applications of the ideal of individual sovereignty to the realm of the private law society on the one side and to the `public' realm of

collective-political choice on the other.},
 author = {Vanberg, Viktor J.},
 year = {2008},
 title = {On the Complementarity of Liberalism and Democracy - a Reading of F.A. Hayek and J.M. Buchanan},
 keywords = {democracy;liberalism},
 pages = {139--161},
 volume = {4},
 number = {2},
 journal = {Journal of Institutional Economics}
}


