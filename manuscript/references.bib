@incollection{Kitschelt.2002,
 abstract = {The paper has argued for a deep version of causal analysis, yet one that does not lose sight of social mechanisms. The latter show how human beings with deliberative faculites and capacities to choose objectives can act on constraints and opportunities. It is human action that brings about collective outcomes, even though broader socio-economic, institutional and cognitive parameters influence the choice set from which individuals and groups select their courses of action. The paper tries to steer a middle course between an uncompromising structuralism that has a penchant toward excessively deep analysis without human action, on the one hand, and purely conjunctural theories that favor only the shallowest, most proximate of intertemporal social mechanisms.},
 author = {Kitschelt, Herbert},
