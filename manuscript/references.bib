@unpublished{Rodrik.September2004,
 abstract = {Markets can malfunction both when governments interfere too much and when they interfere too little. Development policies of the last two decades have been obsessed with the first category of policy mistakes - governments' errors of commission. Hence the efforts to reduce of rliminate regulations, trade restrictions, financial repression, and public ownership. Governemts' errer of ommission - needed interventions that were not supplied - were demphasized, in part as a reaction to the strong emphasis placed on them by earlier policies of import substitution. Recently governments around the world have begun to seek a more balanced strategy, as liberalization and privatization have failed to deliver the expected performance. I argue in this paper that properly formulated industrial policies have an important role to play in such strategies.},
