@article{Schafer.2020c,
 abstract = {Research on voting behaviour stresses that whether citizens become habitual voters depends on the very first elections in their adult life. This article focuses on the increasing participation gap of first-time voters with low and high levels of resources. Looking first at 14 European countries and second at long-term dynamics in Germany, the turnout rate of first-time and older voters over time is compared. It is shown that the turnout gap has increased substantially since the 1980s. In contrast, educational differences in electoral turnout among older citizens are still comparatively small. It is argued and shown that the turnout gap among the young is due to rising $\backslash$textquoteright costs of voting, which affect mainly those who are resource poor.},
 author = {Sch{\"a}fer, Armin and Ro{\ss}teutscher, Sigrid and Abendsch{\"o}n, Simone},
 year = {2020},
 title = {Rising start-up costs of voting: political inequality among first-time voters},
 url = {https://www.tandfonline.com/doi/full/10.1080/01402382.2019.1638141},
 urldate = {2020-04-01},
 pages = {819--844},
 volume = {43},
 number = {4},
 journal = {West European Politics},
 doi = {10.1080/01402382.2019.1638141}
}


