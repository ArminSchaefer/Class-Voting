@article{Jabko.1999,
 abstract = {The advent of economic and monetary union (EMU) is often interpreted as the logical outcome of structural trends, macroeconomic consensus, or grand geopolitical bargains. This article argues, however, that such views miss an essential dimension of the EMU process, namely the political strategy developed within the European Commission in order to achieve that goal. As part of their integrationist agenda, Commission officials selectively marhsaled the political and economic significance of Europe's emerging Single Market. Thus, over time, they induced key actors to re-articulate their preferences in terms of monetary union. The article discusses the two main facets of the Comiision's strategy, i.e. the politics of moneaty sovereignty and the politics of monetary orthodoxy.},
 author = {Jabko, Nicolas},
 year = {1999},
 title = {In the name of the Market: how the European Commission paved the way for monetary union},
 keywords = {commission;ECB;EMU;German unification;Maastricht Treaty;monetary policy},
 pages = {475--495},
 volume = {6},
 number = {3},
 journal = {Journal of European Public Policy}
}


@article{Jachtenfuchs.1998,
 abstract = {Conflicts over the shape ofthe European Union are usually modelled as conflict of interests. This article argues that the development of a policy depends not only on interests but also on normative ideas about a legitimate political order ('policy-ideas'). These polity-ideas are extremely stable over time ans resistant to change because they are linked to the identiry and basic normative orientations of the actors involved. The article has four parts: (1) a theoretical argument how to link ideas and policy development in the EU, (2) a methodological discussion containing four ideal-gypical polity-ideas about the EU, (3) a comparative analysis of the development of these ideas in France, Germany and the United Kingdom from 1950 to 1995, and (4) a summary of the empirical findings and a discussion of areas of research for which the theoretical approach and the empirical results presented here might be useful.},
 author = {Jachtenfuchs, Markus and Diez, Thomas and Jung, Sabine},
 year = {1998},
 title = {Which Europe? Conflicting Models of a Legitimate European Political Order},
 keywords = {concepts of Europe;economic community;federal state;Integration;intergovernmental cooperation;network;party attitudes;polity-ideas},
 pages = {409--445},
 volume = {4},
 number = {4},
 journal = {European Journal of International Relations}
}


