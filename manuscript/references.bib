@article{Barnard.1999,
 abstract = {In this review we focus on the shift from 'social policy' to employment policy and consider in more detail the impact of the new Employmetn Title of the Amsterdam Treaty which came into force on 1 May 1999. As part of our analysis, we consider the role played by EMU in promoting the new employment policy. We also analyse links between employment policy and the human rights agenda which has emerged from the jurisprudence of the European Court of Justice. This link is made explicit by the inclusion of equal opportunities as one of the four key 'pillars' of the new employment policy.},
