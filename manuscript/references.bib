@article{Cohen.1997b,
 abstract = {This essay promotes visions of democracy, constitutionalism and institutional innovations which may halp to open up new dimensions in the search for legitimate European governance structures and theirconstitutionalisiation. Faced with Europe's legitimacy problems, proponents of the European project often react by pointing to the many institutional failings in the (national) constitutioanl state. These reactions, however, seem simplistic, offereing no normatively convincing alternatives to the once undistputed legitimacy of  a now eroding nation state. The essay forecloses such strategies. Summarising and endorsing crititques of both the unfettered market system and the maner of its equilibria  between well-functioning markets and well-ordered political institutions are doomed to fail, and opts instead for fundamental change: conservative in their strict defence of fundamental democratic ideals, such ideas are radical in their search for new institutional arrangements which bring democratic values directly to bear. how is the conept of directly-deliberative polyarchy complementary to an d reconcilable with our notions of democratic constitutionalism? To this question the readers will find many fascinating answers. Equally, however, howmight the deaate on the normative and practical dilemmas of the European system of governance prfit from these deliberations? Whcih European problem might be resolved with the aid of the emerging and new direct forms of democracy indentified in this essay? How might direct democracy interact with the intergovernemtalist and the funjctionalist elements of the EU system? Although this essay contains no certain answers to these European questions, its challenging messages will be understood in European debates.},
 author = {Cohen, Joshua and Sabel, Charles},
 year = {1997},
 title = {Directly-Deliberative Polyarchy},
 keywords = {benchmarking;deliberation;Demokratietheorie;Habermas;local learning;monitoring;participation},
 pages = {313--342},
 volume = {3},
 number = {4},
 issn = {1468-0386},
 journal = {European Law Journal}
}


