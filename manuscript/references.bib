@article{Zohlnhofer.2005,
 abstract = {The article analyses the impact of the European Employment Strategy on German policies. The Luxembourg Process contains concrete, quantitative objectives as well as relatively hereogeneous proposals that allow rather antithetical national policies. Nevertheless, it marks a specific European path, emphasising state-led activiation strategies. Applying clear and varifiable criteria, we analyse the impact of the guidelines, the quantified objectives and he recommendations on German employment policies and find that ethey selectively influenced German policies, normally catalysing existing policies (intensifier effects) but sometimes also inducing a policy change (steering effects). The impact varies depending on the concreteness of the guidelines and the party composition of the government.},
 author = {Zohlnh{\"o}fer, Reimut and Ostheim, Tobias},
