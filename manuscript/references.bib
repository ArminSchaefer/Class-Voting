@article{Gorges.2001,
 abstract = {This article applies new institutionalist perspectives on institutional change to the inclusion in the Maastricht Treaty of social dialogue provisions giving the social partners the right to participate in social policy-making. It concludes that the new institutionalism cannot explain institutional change. By relying on exogenous variables such as 'critical junctures', 'leadership' or 'ideas', new institutionalist analyses resort to a collection of explanations that proponents of almost any theoretical perspective could use. The new institutionaism's failure to develop an institutionalist account of change is a serious weakness that binrgs into question its use as an analytical tool in EU studies.},
