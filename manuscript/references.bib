@article{Aust.2000b,
 abstract = {Der Beitrag untersucht die Entwicklung der Europ{\"a}ischen Besch{\"a}ftigungspolitik seit ihrer Verankerung in dem Amsterdamer Vertrag (besch{\"a}ftigungspolitische Leitlinien, Besch{\"a}ftigungspakt und Lissabonner Sondergipfel). Der Autor geht dabei von zwei konkurrierenden Konzepten - Dritter Weg und Eurokeynesianismus - aus, skizziert diese kurz und geht dann der Frage nach, ob, von wem bef{\"o}rdert und wie sich diese Konzepte in der Europ{\"a}ischen Besch{\"a}ftigungspolitik niederschlagen. Es l{\"a}sst sich zeigen, dass die besch{\"a}ftigungspolitischen Leitlinien den Grundgedanken des Dritten Weges folgen. Strategiekonzepte f{\"u}r einen Eurokeynesianismus standen w{\"a}hrend des Verhandlungsprozesses zum Europ{\"a}ischen Besch{\"a}ftigungspakt ganz oben auf der Agenda, konnten sich allerdings nur in engen Grenzen durchsetzen. Das Ergebnis ersch{\"o}pft sich in der Verabredung eines weitgehend unverbindlichen makro{\"o}knomischen Dialogs zwischen den wichtigsten  wirtschaftspolitischen Akteuren auf der europ{\"a}ischen Ebene. Von einem makro{\"o}konomischen Kurswechsel, wie er von dieser Strategievariante vor allem f{\"u}r die Geldpolitik gefordert wurde, ist zumindest bislang nichts zu sp{\"u}ren.},
 author = {Aust, Andreas},
 year = {2000},
 title = {'Dritter Weg' oder 'Eurokeynesianismus'? Zur Entwicklung der Europ{\"a}ischen Besch{\"a}ftigungspolitik seit dem Amsterdamer Vertrag},
 keywords = {Besch{\"a}ftigungspakt;EES;Essen Follow-up;Eurokeynesianismus;Geldpolitik;Giddens;guidelines;K{\"o}ln-Prozess;Leitlinien;macro-economc dialogue;Neo-voluntarismus;Post-Maastricht-Krise;Sozialdemokratie;TEN;Third Way;White Paper},
 pages = {269--283},
 volume = {3},
 journal = {{\"O}sterreichische Zeitschrift f{\"u}r Politikwissenschaft}
}


@incollection{Aust.2004,
 abstract = {{\textquotedbl}In der Tradition der Kompensationsthese wird h{\"a}ufig auf kleine offene {\"O}konomien verwiesen, wenn die Effektive des Regimewettbewerbs relativiert werden sollen. In diesem Beitrag gingen wir anhand der beiden L{\"a}nder {\"O}sterreich und Irland der These nach, dass die Aussagen {\"u}ber die harmonische Vereinbarkeit von keynesianische Wohlfahrtsstaat' und offener {\"O}konomien ein historisch kontingentes und damit h{\"o}chst voraussetzungsvolles Verh{\"a}ltnis betreffen. Die Entwicklung {\"O}sterreichs illustriert bis in die 80er Jahre exemplarisch die These von Cameron, ab Mitte der 80er Jahre jedoch erodieren die politischen Rahmenbedingungen, und es kommt zu einer Abkehr vom Austrokeynesianismus. In Irland hingegen scheitert der Aufbau analoger wohlfahrtsstaatlicher Politik von Anfang an an fehlenden sozio-{\"o}konomischen und politischen Faktoren und m{\"u}ndet schlie{\ss}lich in die Krise der 80er Jahre.{\textquotedbl} (317)},
 author = {Aust, Andreas and Leitner, Sigrid},
 title = {Zur sozialpolitischen Entwicklung kleiner offener {\"O}konomien. {\"O}sterreich und Irland im europ{\"a}ichen {\textquotedbl}Regimewettbewerb{\textquotedbl}},
 keywords = {Austria;competitiveness;Ireland;social pacts;welfare state},
 pages = {297--321},
 publisher = {{Verlag f{\"u}r Sozialwissenschaften}},
 editor = {L{\"u}tz, Susanne and Czada, Roland},
 booktitle = {Wohlfahrtsstaat - Transformation und Perspektiven},
 year = {2004},
