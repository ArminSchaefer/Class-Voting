@article{Ward.1991,
 abstract = {Summary: {\textquotedbl}This Commentary takes issue with the claim that republicanism can incorporate organized disadvantaged groups as separate political entities into a polity based on deliberation and citizenship. Governmentenforced special treatment for such groups is fundamentally at war with the most basic purpose of republican community: to promote the interconnectedness of all citizens and their ability to arrive at a collective definition of the common good, which the state then implements. If I may borrow half a phrase from Robert Cover, by its nature the grouporiented liberal state is {\textquotedbl}communo-pathic{\textquotedbl}; to survive as an entity that is conceptually separate from interest-group liberalism, a republican community must reject {\textquotedbl}groupthink{\textquotedbl} altogether.{\textquotedbl} 583)},
