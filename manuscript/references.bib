@article{Merkel.2000,
 abstract = {Am Ende des 20. Jahrhunderts haben sich dieKontexte sozialdemokratischen Regierungshandelns dramatisch ver{\"a}ndert. Blair, Giddens und NewLabour haben mit dem Konzept des Dritten Wegs eine Debatte in die Sozialdemokratie getragen, die insbesondere in der praktischen Regierungspolitik die Z{\"u}ge einer programmatisch-strategieschen Konkurrenz angenommen hat. Der Beitrag stellt vier paradigmatische Wege der europ{\"a}ischen Sozialdemokratie vor, indem er die Regierungspolitik der britischen, holl{\"a}ndischen, schwedischen und franz{\"o}sischen Sozialdemokraten/Sozialistien in wichtigen Bereichen (Fiskal-, Besch{\"a}ftigungs, Sozialdpolitik) diskutiert. An der Leistungsperformanz der vier Regierungen werden spezifische Politikmuster erkennbar: Now Labour und die holl{\"a}ndischen Sozialdemokraten weisen eine sehr gute Besch{\"a}ftigungsbilanz auf, die u.a. mit Abstrichen in densozialstaatlichen Sicherungsstandards bewusst 'erkauft' werden. Die schwedischen Sozialdemokraten und insbesondere die franz{\"o}sischen Sozialisten haben dagegen eine m{\"a}{\ss}ige bzw. schlechte Besch{\"a}ftigungsbilanz bei weiterhin hohen wohlfahrtsstaatlichen STandards. Wenn auch in unterschiedlichem Ma{\ss}, so untersch{\"a}tzen alle vier sozialdemokratischen Parteien die EU als einen wichtigen 'strategischen Handlungsraum' f{\"u}r das 21. Jahrhundert. Der Aufsatzpr{\"u}ft deshabl abschlie{\ss}end die Kooperations- und Konzertierungspotenziale der Sozialdemokratie auf europ{\"a}ischer Ebene.},
 author = {Merkel, Wolfgang},
 year = {2000},
 title = {Die Dritten Wege der Sozialdemokratie ins 21. Jahrhundert},
 keywords = {european employment strategy;France;new labour;Sweden},
 pages = {99--124},
 volume = {10},
 number = {1},
 journal = {Berliner Journal f{\"u}r Soziologie}
}


@unpublished{Merkel.2002,
 abstract = {Der Aufsatz verbindet die normative Diskussion {\"u}ber Soziale Gerechtigkeit in der politischen Philosophie mit empirischen Ergebnissen aus der Sozialstaatsforschung. Damit verbindet er zwei Diskussionsstr{\"a}nge, die bisher meist isoliert voneinander verlaufen sind. Die Argumentation wird {\"u}ber die Beantwortung von vier Fragen entfaltet. Der normativen Frage: welche regulativen Leitideen liefert die Gerechtigkeitsdebatte in der politischen Philosophie? Der handlungstheoretishen Frage: welche Urteilkriterien und Handlungspr{\"a}ferenzen lassen sich f{\"u}r eine gerechtigkeitsorientierte Politik gewinnen? Der empirischen Frage: Wie lassen sich die drei Welten des Wohlfahrtskapitalismus auf dem Hintergrund der hierarchische geordneten Gerechtigkeitskriterien beurteilen? Sowie schlie{\ss}lich der institutionellen Frage: welche instiutionelle Logik eine (notwendig gewordene) Reform des Sozialstaats tragen soll, wenn diese gleichzeitig sozial gerecht sein und eine realistische Aussicht auf ihre Realisierung haben soll.},
 author = {Merkel, Wolfgang},
 year = {2002},
 title = {Soziale Gerechtigkeit und die drei Welten des Wohlfahrtskapitalismus: Projekt: Sozialdemokratische Antworten auf integrierte M{\"a}rkte - Dritte Wege im internationale Vergleich},
