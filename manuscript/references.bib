@article{McDonald.2004,
 abstract = {Democracy is often described as a system in which a majority of electors choose one out of a number of competing parties to form a government and carry out its programme. Unforutnaetly, spontaneious majorities rarely form in support of one party. We generalize from a 'government' to a 'median' mandate, in which the median elector chooses the pivaltal party in parliament, which then translates his or her preferences into public policy. To check this we investigate how accuratey parliamentats and governments represent the left-right- polisition of the median voter in each of twenty parliamentary democracies. Distoritions depend on the type of electoral arrangement, being relatively smaller under proportional representation than under singlemember districts. Distortions to not equate to biased represettation, however. Once we consider how distoration at one step or one time are competnsated by distortion ins the opposite direction at another, overall representation of the median voter position is reasonalby accurate.},
 author = {McDonald, Michael D. and Mendes, Silvia M. and Budge, Ian},
 year = {2004},
 title = {What Are Elections For? Conferring the Median Mandate},
 pages = {1--26},
 volume = {34},
