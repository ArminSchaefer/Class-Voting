@article{Hix.2003,
 abstract = {The article looks at the development of the two main features of the party system in the EP: the organization of the party groups, and the nature of competition between these groups. On the organizational side, we examine the foundation of the party groups in the Common Assembly and the evolution of party organization from the appointed the the elected Parliament. On the competition side, we focus on the main axis of competition: the relationship between the PES and the EPP. We develop a set of propositions aber PES{\_}EPP collusion, and test these arguments in a statistical analysis of PES and EPP roll-call voting since 1979. We conclude that, contrary to what might be expected, the party system in the EP has become more consolidated and more competitive as the powers of the EP have increased.},
 author = {Hix, Simon and Kreppel, Amie and Noury, Abdul},
 year = {2003},
 title = {The Party System in the European Parliament: Collusive or Competitive?},
 keywords = {European Parliament;parties},
