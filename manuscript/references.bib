@article{Syrpis.2001,
 abstract = {This article provides a critical appraisal of the Commission's Social Policy Agenda (COM(2000)379), which lays down a five-year programme of action in the social policy field. In the Agenda there is extensive reference to the 'open method of coordination', a new regulatory strategy which is designed to help Member States to progressively develop their own policies. The open method of coordination is analysed in the light of the internal market case law of the Court, in particular Case C-376/98 Germany v. European Paliament and Council. The main contention of the article is that a necessary precondition to the long-term success of any regulatory strategy founded on diversity, such as that espoused in The Commission Agenda, is that the Court amends its current understanding of what is required for the establishment and functioning of the market, and that it accepts that differences between the laws of the Member States do not in themselves constitute a threat to the realisation of the internal market project.},
 author = {Syrpis, Phil},
 year = {2001},
 title = {Smoke without Fire: The Social Policy Agenda and the Internal Market},
 keywords = {ECJ;omc;social policy},
 pages = {271--288},
