@article{Singh.2011,
 abstract = {In a recent contribution to Political Behavior (30:455--467), Panagopoulos, using aggregate turnout data, shows that individuals living under compulsory voting rules are most likely to go to the polls when penalties for abstaining are both strict and routinely enforced. In this project, I expand on the work of Panagopoulos by simultaneously examining both election-level and individual-level factors. I use a broad sample of 36 countries, some with compulsory voting and some with voluntary rules, which provides a more detailed understanding of the correlates of

