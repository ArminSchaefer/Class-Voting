@book{Hasenclever.1997,
 abstract = {In this book we have argued that three schools of thought coexist in the study of international regimes. Each of these schools focuses on a specific variable, which helps to define its identity. Neoliberals stress (self-)interest as a motive for cooperation among states andlikewise for the creation of, and compliance with, international regimes. Realists emphasize how power and considerations of relative power postition affect the content, and circuscribe the effectiveness and robustness, of international regimes. Cognitivists point out that both the perception of interests and the meaning of power capabilities is dependent on actors' causal and social knowledge.},
