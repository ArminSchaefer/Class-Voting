@article{Begg.2002,
 abstract = {This paper explores the links betwen EMU and employment, and appraises the implications for employment of the emerging macroeconomic policy framework in the Euro-zone. It notes that a significant improvement in the ability of the EU economy to create jobs will be needed if the ambitious targets set at the Lisbon European Council are to be achieved, and it is argued that the detailed breakdown is important. Although the overall impact of EMU on employment will be greatly affected by how well the EU economy as a whole is able to perform, the paper suggests that an important influence will be the gegree to which MEU becomes a catalyst for change in the labour market. Six propositions are put forward for moving towards a more effective role for the labour market in adjustment without imposing unacceptable costs. The paper concludes with some observations on the potential contribution of different 'economic and social actors'.},
