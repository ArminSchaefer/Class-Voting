@incollection{Moravcsik.1994,
 abstract = {The liberal intergovernmentalist view seeks to account for major decisions in the history of the EC by positing a two-stage approach. In the first stage, national preferences are primarily determined by the constraints and opportunities imposed by economic interdependence. in the second stage, the outcomes of intergovernmental negotiations are determinedbythe realitve bargaining power of governments and the functional incentives forinstitutionalization created by high transaction costs and the desire to control domestic agendas. This approach is grounded in fundamental concepts of international policitcal economy, negotation analysis, and regime theory.

Der Aufsatz beschreibt die Grundlagen des intergouvernementalen Ansatzes. Politik in der EU wird durch zwei Schritte erkl{\"a}rt: Erstens, die Pr{\"a}ferenzformierung innerhalb der MS, die im Wesentlichen durch die Kosten/Nutzen {\"U}berlegung Betroffener zur{\"u}ckzuf{\"u}hren sind. Das hei{\ss}t, stark betroffene, gut organisierte Produzenteninteressen lassen den Regierungen wenig Spielraum f{\"u}r Verhandlungen auf europ{\"a}ischer Ebene. Im zweiten Schritt wird der Bargaining-Prozess zwischen den MS beschrieben. Der wird durch die Macht und Pr{\"a}ferenzen (s.o.) der MS bestimmt. Allerdings gibt es Spielraum f{\"u}r 'package deals', weil sich die Pr{\"a}ferenzordnungen unterscheiden und MS bereit sind, Zugest{\"a}ndnisse in einem unwichtigem Feld zu machen, um ihre Kerninteressen durchzusetzen. Supranationale Institutionen haben den Zweck, die Verhandlungen effizienter zu gestalten und der Spielraum von Regierungen gegen{\"u}ber innenpolitischen Akteueren zu erh{\"o}hen. Dem Pooling oder der Delegation von Macht liegt eine rationale Kalkulation zugrunde, die Kosten (das Risiko, {\"u}berstimmt zu werden) und Nutzen (effiziente Verhandlung) abw{\"a}gt.},
 author = {Moravcsik, Andrew},
 title = {Preference and Power in the European Community: A Liberal Intergovernmentalist Approach},
 keywords = {delegating;interstate bargaining;liberal intergovernmentalism;pooling;preferences;two-level games},
 pages = {29--80},
 publisher = {{Blackwell Publishers}},
 editor = {Bulmer, Steve and Scott, Andrew},
