@article{CeesvanderEijk.1996,
 abstract = {With four sets of EP elections now behind us, it is appropriate to review the prevailing interpretation of such elections as second-order national elections, a view first put forward by Reif and SChmitt in 1980. While the second-order model has yielded important insights into the way EP elections can be understood as manifesting national political processes, more recent research has fruitfully turned the model on its head, and focused on what European elections can tell us about national elections and the nature of boting act. Indeed, the use of individual-level survey data to study elections to the EP has for the first time truly shown us the importance of institutional and political context in conditioning turnout and party choice. Findings of recent research suggest that the second-order features of EP elections hsould be thought of as contextual variables that can affect other elections as well.},
