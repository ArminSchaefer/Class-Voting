@article{Aust.1997,
 abstract = {Ziel dieses Beitrages ist die Thematisierung der Sozial- und Besch{\"a}ftigungspolitik in der Regierungskonferenz 1996/1997 nachzuzeichnen und eine begr{\"u}ndete Bewertung dieser Vertragserneuerungen zu geben. Dazu wird zun{\"a}chst die Ausweitung der vertraglich fixierten sozialpolitischen Kompetenzen der Gemeinschaft durch die Einheitlich Europ{\"a}ische Akte (EEA) und den Maastrichter Vertrag nachgezeichnet. Anschlie{\ss}end wird die Politisierung der Besch{\"a}ftigungskrise als europ{\"a}isches Problem im zusammenhang der 'Post-Maastricht-Krise' dargestellt, um auf diesem Hintergrund die Verhandlungen und das Ergebnis der Regierungskonferenz zu analysieren. Das Besch{\"a}ftigungskapitel wird vor allem der 'symbolischen Politik' zugerechnet, da es im Wesentlichen unverbindlich und nicht sanktionierbar bleibt.},
