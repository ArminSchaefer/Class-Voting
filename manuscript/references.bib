@article{Moravcsik.2002,
 abstract = {Concern about the EU's democratic deficit is misplaced. Judged against existing advanced industrial democracies, rather than an ideal plebiscitary or parliamentary democracy, the EU is legitimate. Its institutiojns are rightly constrained by constitutional checks and balances: narrow mandates, fiscal limits, super--majoritarian and concurrent voting requirements and separation of powers. The EU's appearance of exceptional insulation reflects th subset of functions it performs - central banking, constitutional adjudication, civil prosecution, economic diplomacy and technical administration. These are matters  of low electoral salience commonly delegated in national systems, for normatively justifiable reasons. On balance, the EU redresses trather than creates biases in policial representation, deliberation and output.},
 author = {Moravcsik, Andrew},
