@book{Allen.2018,
 abstract = {There is a gap between politicians and the general public. The current British political class is widely viewed as uniform in who they are, what they think, and how they behave.  A more diverse pool of politicians would not only better reflect democratic principles of equality, but may even result in better political outcomes.},
 author = {Allen, Peter},
