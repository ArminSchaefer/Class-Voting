@incollection{Albo.1994,
 abstract = {Albo konstatiert, dass die heutige Besch{\"a}ftigungspolitik im Kern Angebotspolitik ist. Diese gibt es in zwei Varianten: der neoliberalen und der sozialdemokratischen. Letztere ist keine reine Deregulierungsstrategie, sondern setzt auf h{\"o}here Wettbewerbsf{\"a}higkeit durch Flexibilisierung und HRM. Wichtigster Faktor ist hierbei die Qualifizierung von Arbeitskr{\"a}ften, um den Standort zu sichern. Albo kritisiert beide Strategien, weil sie seiner Meinung nach das Problem der Arbeitslosigkeit nicht l{\"o}sen werden, dessen Kern in internationalem Nachfragemangel besteht, der durch den Regime- und Kostenwettbewerb nur verst{\"a}rkt wird. Die 'Angebotspolitik von links' f{\"u}hrt zu einer zunehmenden Spaltung der Gesellschaft in eine Gruppe von hochausgebildeten, wettbewerbsf{\"a}higen Kernarbeitnehmern und den low-skilled, prek{\"a}r Besch{\"a}ftigten oder Arbeitslosen, denen der Zugang zum Arbeitsmarkt verwehrt bleibt.},
 author = {Albo, Gregory},
 title = {'Competitive austerity' and the impasse of capitalist employment policy},
 keywords = {Anglo-Saxon capitalism;competitive austerity;employment policy;flexible adjustment;progressive competitiveness model;skills;supply side economics;training},
 publisher = {{The Merlin Press}},
 editor = {Miliband, Ralph and Panitch, Leo},
 booktitle = {The Socialist Register - 1994},
 year = {1994},
 address = {London}
