@incollection{Howlett.1993,
 abstract = {Der Beitrag gliedert sich in drei Teile: Der erste Teil behandelt die vorliegende Lieratur {\"u}ber Policy-Instrumente und analysiert deren St{\"a}rken und Schw{\"a}chen. Indem gezeigt wird, auf welche Weise sich die einzelnen Theorien mit der Frage der Privatisierung auseinandersetzen, wird deutlich, da{\ss} die existierende Literatur wenig dar{\"u}ber aussagen kann, warum und wie sich relativ langfristige Muster der Wahl von policy-Instruemtne ver{\"a}ndern. Der zweite Teil befa{\ss}t sich mit der Hypothese, da{\ss} einzelne Aspekte der seit j{\"u}ngster Zeit gef{\"u}hrten diskussion {\"u}ber Policy-Lernen viel dazu beitragen kann, den Wandel im Gebrauch von Policy-instrumenten, einschlie{\ss}lich der langfristigen Ver{\"a}nderung der Instrumentenwahl und der Privatisierung im transnationalen Vergleich, zu verstehen. Der dritte und letzte Teil skizziert Elemente eines Lernmodells der Instrumentenwahl. Es wird arguementiert, da{\ss} die Wahl von Policy-Instrumenten eine 'erlernbare Erfahrung' ist, da{\ss} sowohl staatliche als auch gesellschaftliche Akteure lernen und da{\ss} dieses Lernen sich {\"u}ber Raum und Zeit erstreckt und entweder in kleine {\"A}nderungen oder paradigmeatische Verschiebungen im Instrumentengebrauch m{\"u}ndet.},
 author = {Howlett, Micheal and Ramesh, M.},
 title = {Policy-Instrumente, Policy-Lernen und Privatisierung: Theoretische Erkl{\"a}rungen f{\"u}r den Wandel in der Instrumentenwahl},
 keywords = {diffusion;Ideentransfer;Instrumentewahl;Policy-Analyse;Policy-Lernen;Privatisierung},
