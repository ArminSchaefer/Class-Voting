@article{Schmidt.1996,
 abstract = {This essay explores the possiblities and limits of partisan influence on public policy in democratic nationa. It will be pointed out, that differences in party composition of government, in general, matter in public policy in constitutional democracy. However, the extent to which parties influence public policy is to a significant extent contingent upon the type of democracy and countermajoritarian institutional constraints of central state government. Large partisan effects typify majoritarian democracies and states, in which the legislature and the executive are 'sovereign'. More complex and more difficult to identify is the partisan influence on pulib policy in consensus democracies and in stats, in which the political-institutional circumstances allow for co-governance of the opposition party. Narrowly circumscribed is the room to manoeuvre available to incumbent parties above all in political systems which have been marked by countermajoritarian institutional pluralism or institutional 'semi-sovereignty'. The article suggests, that it would be valuable if direct effects and interaction effects of the party composition of government and state structures features more prominently in future research on comparative public policy.},
 author = {Schmidt, Manfred G.},
 year = {1996},
 title = {When parties matter: A review of the possibilities and limits of partisan influence on public policy},
 pages = {155--183},
 volume = {30},
 journal = {European Journal of Political Research}
}


@incollection{Schmidt.1997,
 abstract = {What most national governemtns as well as scholars overlook in their assessment of the impact of European integration, however, are the problems related to democracy. Most member-states' traditional formulae for democracy have been threatened by the superimposition of European instiutional structures and policymking processes on their own structures and processes and by non-business societal intersts' loss of access to decision-making  at national and supranational levels. But the nature and degree of threat to member-state democracy and cititzen access differs from one coutnry to the next, with the democracies of member-states with more centralized, unitary states characterized by a statist model of policy-making more likely to be threatened by the EU's more federal strucute and pluralist model of policy-making than those with more decentralized, federal states with a corporatist model of policymaking.},
 author = {Schmidt, Vivien A.},
 title = {European Integration and Institutional Change: The Transformation of national Patterns of Policy-making},
 keywords = {bureaucracy;confusion of powers;corporatism;democratic deficit;EU institutional structures;European integration;lobbying;Moravcsik;pluralism;pooled sovereignty;statism;subversive liberalism;two-level games},
 volume = {Leviathan, Sonderheft 16},
 publisher = {{Westdeutscher Verlag}},
 editor = {G{\"o}hler, Gerhard},
 booktitle = {Institutionenwandel},
 year = {1997},
 address = {Opladen}
}


