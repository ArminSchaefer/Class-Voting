@incollection{LaPorte.2002f,
 abstract = {This introductory chapter is divided into three sections.

The first reviews recent developments in EU social policy, in particular focusing on the infiltration of soft tools into this policy field. This is followed by an explanation of the emergence of OMC, which first emanated from the economic area, after which it was selected for emploment oplicy co-ordination and for co-ordination in chosen areas of social protection.

The second section briefly evaluates the relevance of the supranational and intergovernmental approaches to explain the on-going dynamic under the auspices of OMC, ultimately suggesting that an alternative approach should be adopted to understand the dynamics of OMC.

Finally, the third section, divided into three parts, consists of an analysis of the effect of the different forms of OMC in national contexts. The first analyses the effects of the OMC according to two axes, the degree of European integration and the potential national impact. The second differentiaties the potential effects of OMC in the social arena - emplyoment, poverty and social exclusion and pensions - according to a structura characteristic, the type of welfare states regime. The third part completes the differentiation according to the structural characteristics by addressing the dynamic element of the Euorpean policy discourse, adopted consensually in the national arena as a whole, or used by certain politica parties. The concluding remarks sum up the principal findings.},
 author = {de {La Porte}, Caroline and Pochet, Philippe},
 title = {Supple co-ordination at EU level and the key actors' involvement},
 keywords = {Employment strategy;Lisbon strategy;national impact;omc;policy coordination},
 pages = {27--68},
 publisher = {{PIE Lang}},
 editor = {{Caroline de la Porte} and Pochet, Philippe},
 booktitle = {Building Social Europe through the Open Method of Co-ordination},
 year = {2002},
 address = {Br{\"u}ssel u.a.}
}


@article{LaPorte.2004,
 abstract = {The OMC's emphasis on transparency, democratic participation and learning has led to a particular interest in this governance mechanism from the perspective of deliberative democracy. This article analyses the 'democratic' dimension of the OMC from a normative and an empirical perspective. We first present relevant theories of deliberative democracy, from which we derive a list of normative criteria, which we then use to explore the democratic quality of the OMC in the areas of employment and pensions. The empriical analysis reveals that there are important differences in the democratic quality of theOCM between these two areas, but that, ultimately, the OMC (as yet) does not live up to its own democratic ambitions.},
 author = {de {La Porte}, Caroline and Nanz, Patrizia},
 year = {2004},
 title = {The OMC - a Deliberative-Democratic Mode of Governance? The Cases of Employment and Pension},
 keywords = {deliberation;democracy;EES;omc},
 pages = {267--288},
 volume = {11},
 number = {2},
 journal = {Journal of European Public Policy}
}


