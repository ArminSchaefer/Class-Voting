@unpublished{Cameron.30.5.2000,
 abstract = {Insgesamt wird Essen und Luxemburg positiv eingesch{\"a}tzt. Hervorgehoben wird vor allem die erstaunliche Europ{\"a}isierung, die bedeutet, dass europ{\"a}ische Institutionen einen erhebliches Mitspracherecht in einem {\textquotedbl}nationalen{\textquotedbl} Politikfeld haben.

The paper examines the Europeanization of employment policy. It seeks, in particular, to understand how and why this process of change - for Europeanization is, by definition, a process of change - occured. The paper consists of four parts. In order to provide a contextual background for this discussion, I first present some date on the variation across time and space in rates of unemployment and employment inthe EU. In the second part, I suggest some of the reasons why some of the member states have been more successful than others in reducing the rate of unemployment and raising the rate of employment in recent years. In the third part, I discuss how emplyoment  policy became {\textquotedbl}Europeanized{\textquotedbl} over the past several years, concentrating on the role ployed by the political leaders of the member states acting through the recurring meetings of the European Council. And in the fourth part, I consider first why emplyoment policy became {\textquotedbl}Europeanized{\textquotedbl} and conclude by considering whether the process of Europeanization has had, or is likely to have, a discernible impact on the rates of unemployment in the member states.},
 author = {Cameron, David R.},
 year = {2000},
 title = {The Europeanization of Employment Policy},
 keywords = {coordinaton;EES;Essen Follow-up;Europeanization;hysteresis;Luxembourg Process;structural unemployment},
 address = {K{\"o}ln}
}


