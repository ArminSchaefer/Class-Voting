@article{Rehfeld.2009,
 abstract = {The trustee/delegate problem purportedly expresses how closely a representative's votes in the legislature should correspond to their constituents' preferences. In this article, I argue that the usual formulation of this debate collapses three distinctions---aims, source of judgment, and responsiveness---and thus obscures the underlying complexity of the phenomenon. Given its tripartite formulation, the collapse of these distinctions into a binary ``trustee/delegate'' formulation obscures a more complex political landscape with eight---rather than two---ideal types. Furthermore, once unpacked, we can see that the distinctions operate entirely independent of the location of authority, leading to the seemingly paradoxical instructed trustees and independent delegates. I also claim that the three distinctions apply to any decision maker, and thus, the attribution of this problem as distinctive of democratic political representation is an important overstatement. The article thus contributes to a more general theory of political representation that can be applied in nonelectoral and nondemocratic contexts increasingly relevant to global politics.},
 author = {Rehfeld, Andrew},
 year = {2009},
 title = {Representation Rethought: On Trustees, Delegates, and Gyroscopes in the Study of Political Representation and Democracy},
 pages = {214--230},
 volume = {103},
 number = {02},
 journal = {American Political Science Review}
}


@misc{Rehm.2001,
 abstract = {Der folgende Beitrag versucht eine Verkn{\"u}pfung zwischen den beiden Forschungs- und Politikfeldern Wohlfahrtsstaat und Arbeitsmarkt. Wir lehnen uns dabei an {\"U}berlegungen von Esping-Andersen {\"u}ber die 'Drei Welten des Wohlfahrtsstaats' an. Dies gilt zum einen in methodischer Hinsicht, da es hier ebenefalls um die Identifikation distinkter Typen geht - womit etwa Thesen einer alles einebnenden Globalisierungs- oder Amerikanisierungswell abgelehnt werden. Dies gilt zum anderen aber auch f{\"u}r die Annahmen, dass zwischen den beiden Sph{\"a}ren der Gesellschaft enge Wechselbeziehugnen bestehen. Im Unterschied zu anderen Arbeiten zielen wir allerdings nicht darauf ab, den sch{\"a}dlichen oder heilsamen Einfluss der Sozialpolitik bzw. eines Wohfahrtsstaatstypus statistisch zu erfassen. Statt dessen versuchen wir, beide Aspekte in einer politisch-{\"o}konomischen Konfiguratin zusammenzuf{\"u}hren.},
 author = {Rehm, Philipp and Schmid, Josef},
 date = {2001},
 title = {Die vier Welten der Besch{\"a}ftigung. Eine explorative Analyse der arbeitsmarktpolitischen Performanz und politisch-{\"o}konomischen Korrelate in 10 Industriel{\"a}ndern 1980-2000},
 keywords = {Arbeitsmarktpolitik;Esping-Andersen;welfare capitalism},
 address = {T{\"u}bingen},
