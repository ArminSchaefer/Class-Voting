@incollection{Thelen.2003,
 abstract = {Thelen biete eine {\"U}bersicht {\"u}ber verschiedene Erkl{\"a}rungen f{\"u}r die Existenz von Institutionen: funktionale, power-distributional, sociological. All diese werden als unvollst{\"a}ndig angesehen, weil sie vom Ergebnis auf die Ursache schlie{\ss}en. Der Schwerpunkt des Aufsatzes liegt darin, die oft gebrauchte Dichotomie von Zeiten des Wandels und der Stabilit{\"a}t zu {\"u}berwinden. Sie argumentiert, dass Stabilit{\"a}t oft von Wandel abh{\"a}ngt und wir gleichzeitig erstaunliche Kontinuit{\"a}t sowie (interne) Ver{\"a}nderungen beobachten k{\"o}nnen. W{\"a}hrend {\textquotedbl}increasing returns{\textquotedbl} Pfad{\"a}bh{\"a}ngigkeiten gut erkl{\"a}ren, bieten sich {\textquotedbl}layering{\textquotedbl} und {\textquotedbl}conversion{\textquotedbl} an, Ver{\"a}nderungen innerhalb der Form zu erl{\"a}utern. Damit vermeidet Thelen ein deterministisches Verst{\"a}ndnis der institutionellen Entwicklung.

