@article{KohlerKoch.1996,
 abstract = {Looking at the transformation of governance in the process of European integration confronts us with a puzzle. Member states have accepted an incremental transfer of sovereignty and regulatroy power. Empirical evidence, however, gives proof of a rather unrestricted vitality to shape policies according tonational preferences. In European policy-making the balance between private and public iknterests seems to have shifted to the detriment of the latter. At the same time the very properties of the European politiy enable public actors to escape capture. In order to gain a better understanding of the transformation of governance it might be helpful to take a different approach. Itis not the change in terms of shifting power relations between different levels of government or between different categories of actors which is of interest, but changes in the practice of governing and the understanding of what governance is about.},
 author = {Kohler-Koch, Beate},
 year = {1996},
 title = {Catching up with Change: the Transformation of Governance in the European Union},
 keywords = {governance;Kontextsteuerung;networks;policy learning;transformation of the state;Verhandlungsstaat},
 pages = {359--380},
 volume = {3},
 number = {3},
