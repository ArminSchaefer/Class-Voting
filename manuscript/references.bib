@article{Christopher.2001b,
 abstract = {This article argues that its character as a non-state political system makes little difference to how he EU ought to be legitimated. Minimum requirements for the legitimation of the liberal democratic state (performance, democracy and identity) also hold for the legitimation of Union power, both normatively and sociologically. This constrains the application of innovative legitimation strategies to the Union, requiring that post-parliamentary solutions be recast as complements, rather than substitutes, for a system of representative politics in the European arena, if the EU is to met the core standard of democratic rule, which we take to be public control with political equality.},
