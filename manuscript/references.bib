@article{Clemens.1999,
 abstract = {From the complex literatures on 'institutionalisms' in political science and sociology, various components of instutitional change are identified: mutability, contradiction, and mediation. This exercise results in a number of clear presciptions for the analysis of politics and institutional change: disaggregate institutions into schemas and resources; decompose institutional durability into processes of reproduction, disruption, and response to disruption; and, above all, appreciate the multiplicity and heterogeneity of the instituions that make up the social world. Recent empirical work on identities, interests, alternatives, and political innovation illustrates how political scientists and sociologists have begun to document  the consequences of instiuttions contradictions and multiplicity and to trace the workings of institutional containment, diffusion, and mediation.},
