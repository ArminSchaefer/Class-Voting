# R session / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.httr-oauth

# renv
renv/library/
renv/staging/
renv/python/
renv/sandbox/

# targets pipeline store — regenerate with targets::tar_make(), don't commit
_targets/
_targets_r/

# Survey microdata: ESS terms of use prohibit redistribution. This covers
# raw AND processed/cleaned files alike -- individual-level data stays
# individual-level data however much it has been recoded. Document
# provenance/access in DATA_PROVENANCE.md instead of committing files.
data/raw/*
!data/raw/.gitkeep
data/*.rds
data/processed/*
!data/processed/.gitkeep

# Fitted brms model objects are large binaries; track code + seed, not the object.
# Remove this ignore (or move to git-lfs) if you want fits versioned directly.
models/*.rds
!models/.gitkeep

# Quarto render artifacts (any .qmd, not just the manuscript -- these are
# regeneratable from source and go stale silently if left committed)
*.html
*_files/
.quarto/

# OS cruft
.DS_Store
Thumbs.db
.Rproj.user
